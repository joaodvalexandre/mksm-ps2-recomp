+    // MKSM: the vertical blank period of the video mode in SMODE1: PAL (CMOD 3) 50 Hz, anything else 60 Hz. Every
+    // game had NTSC's 60 Hz, so a PAL game's vblank-paced logic ran a fifth too fast.
+    static constexpr uint64_t vblankPeriodMicroseconds(uint64_t smode1)
+    {
+        return ((smode1 >> 13) & 3u) == 3u ? 20000u : 16667u;
+    }
