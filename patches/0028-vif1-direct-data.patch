+// MKSM: DIRECT/DIRECTHL data to PATH2. A GS that keeps each path's state (setGifPathsStateful) gets it as it is. The CPU
+// frontend wants whole GIF packets: data that finishes an IMAGE packet an earlier DIRECT started (a texture's IMAGE tag
+// in one DIRECT, its pixels in the next) is sent with an IMAGE tag of its own.
+void PS2Memory::submitVif1DirectData(const uint8_t *data, uint32_t qwCount, bool directHl)
+{
+    if (qwCount == 0u)
+        return;
+    if (m_gifPathsStateful)
+    {
+        submitGifPacket(GifPathId::Path2, data, qwCount * 16u, true, directHl);
+        return;
+    }
+
+    uint32_t imageQw = 0u;
+    if (m_vif1PendingPath2ImageQwc != 0u)
+    {
+        imageQw = std::min<uint32_t>(m_vif1PendingPath2ImageQwc, qwCount);
+        std::vector<uint8_t> imagePacket(16u + static_cast<size_t>(imageQw) * 16u, 0u);
+        const uint64_t imageTag =
+            static_cast<uint64_t>(imageQw & 0x7FFFu) |
+            ((m_vif1PendingPath2ImageQwc == imageQw) ? (1ull << 15) : 0ull) |
+            (static_cast<uint64_t>(kGifFmtImage) << 58);
+        std::memcpy(imagePacket.data(), &imageTag, sizeof(imageTag));
+        std::memcpy(imagePacket.data() + 16u, data, static_cast<size_t>(imageQw) * 16u);
+        submitGifPacket(GifPathId::Path2, imagePacket.data(), static_cast<uint32_t>(imagePacket.size()), true, directHl);
+        m_vif1PendingPath2ImageQwc -= imageQw;
+    }
+    if (imageQw < qwCount)
+    {
+        const uint32_t restBytes = (qwCount - imageQw) * 16u;
+        submitGifPacket(GifPathId::Path2, data + imageQw * 16u, restBytes, true, directHl);
+        m_vif1PendingPath2ImageQwc = pendingGifImageQwc(data + imageQw * 16u, restBytes);
+    }
+}
