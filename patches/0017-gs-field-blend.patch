+        // MKSM: field rendering is shown as the mean of the displayed field and the one before it. Shaolin Monks draws
+        // every other field half a line lower in its own vertices; shown one after the other, the picture moved a line
+        // every frame.
+        tc.Run("field rendering is presented as the blend of the last two fields", [](TestCase &t)
+        {
+            t.IsTrue(GsFieldBlend::applies(3u), "interlaced frame mode (SMODE2 INT and FFMD) should blend the fields");
+            t.IsTrue(!GsFieldBlend::applies(1u), "interlaced field mode shows each frame as it is");
+            t.IsTrue(!GsFieldBlend::applies(0u), "progressive output shows each frame as it is");
+
+            GsFieldBlend blend;
+            std::vector<uint8_t> first(12u, 0x10u);
+            blend.apply(first, 1u, 3u, 0u);
+            t.Equals(static_cast<uint32_t>(first[0]), 0x10u, "the first field should be shown as it is");
+
+            std::vector<uint8_t> again(12u, 0x30u);
+            blend.apply(again, 1u, 3u, 0u);
+            t.Equals(static_cast<uint32_t>(again[0]), 0x30u, "the same buffer shown again is not its own previous field");
+
+            std::vector<uint8_t> second(12u, 0x51u);
+            second[11] = 0xFFu;
+            blend.apply(second, 1u, 3u, 80u);
+            t.Equals(static_cast<uint32_t>(second[0]), 0x41u, "a new buffer should be blended with the last field (rounded up)");
+            t.Equals(static_cast<uint32_t>(second[11]), 0x98u, "every byte should be blended on its own");
+
+            std::vector<uint8_t> third(12u, 0x20u);
+            blend.apply(third, 1u, 3u, 0u);
+            t.Equals(static_cast<uint32_t>(third[0]), 0x39u, "the next buffer should be blended with the one before it");
+
+            std::vector<uint8_t> resized(16u, 0x70u);
+            blend.apply(resized, 2u, 2u, 80u);
+            t.Equals(static_cast<uint32_t>(resized[0]), 0x70u, "a new frame size should start over");
+        });
