diff --git a/ps2xRuntime/include/runtime/gs/gs_field_blend.h b/ps2xRuntime/include/runtime/gs/gs_field_blend.h
new file mode 100644
index 0000000..fe69596
--- /dev/null
+++ b/ps2xRuntime/include/runtime/gs/gs_field_blend.h
@@ -0,0 +1,81 @@
+#pragma once
+
+#include <algorithm>
+#include <cstdint>
+#include <cstring>
+#include <vector>
+
+// MKSM: field rendering (SMODE2 INT and FFMD: interlaced, every line of the buffer read in each field). A game that
+// draws every other field half a line lower in its own vertices counts on the TV to interleave the fields; shown one
+// after the other, the picture moves a line every frame and thin lines come and go. GsFieldBlend shows the mean of
+// the displayed field and the one shown before it, as the TV's persistence does (PCSX2's "blend" deinterlacing). A
+// field is a displayed buffer: the host refresh is not locked to the game's fields, so a buffer shown again must not
+// become its own previous field.
+struct GsFieldBlend
+{
+    std::vector<uint8_t> current;
+    std::vector<uint8_t> previous;
+    uint32_t width = 0;
+    uint32_t height = 0;
+    uint32_t fbp = 0;
+    uint32_t fields = 0; // how many of current and previous hold a field (0 to 2)
+
+    static bool applies(uint64_t smode2)
+    {
+        return (smode2 & 3u) == 3u;
+    }
+
+    void reset()
+    {
+        fields = 0;
+    }
+
+    // pixels: the frame about to be shown (any byte layout, the same for every frame of this size), from the buffer
+    // at displayFbp. Once two fields are known it is replaced by their per-byte mean, rounded up.
+    void apply(std::vector<uint8_t> &pixels, uint32_t frameWidth, uint32_t frameHeight, uint32_t displayFbp)
+    {
+        if (pixels.empty())
+        {
+            fields = 0;
+            return;
+        }
+        if (frameWidth != width || frameHeight != height || current.size() != pixels.size())
+        {
+            width = frameWidth;
+            height = frameHeight;
+            fields = 0;
+        }
+        if (fields == 0u || displayFbp != fbp)
+        {
+            current.swap(previous); // a new field: the one shown so far becomes the previous one
+            fields = std::min<uint32_t>(fields + 1u, 2u);
+            fbp = displayFbp;
+        }
+        current = pixels;
+        if (fields < 2u || previous.size() != pixels.size())
+        {
+            return;
+        }
+
+        // (a | b) - ((a ^ b) >> 1) is the mean of two bytes rounded up; eight lanes at a time, the mask keeping each
+        // lane's shift to itself.
+        constexpr uint64_t kLaneMask = 0x7F7F7F7F7F7F7F7Full;
+        const size_t size = pixels.size();
+        size_t i = 0;
+        for (; i + 8u <= size; i += 8u)
+        {
+            uint64_t a = 0u;
+            uint64_t b = 0u;
+            std::memcpy(&a, current.data() + i, sizeof(a));
+            std::memcpy(&b, previous.data() + i, sizeof(b));
+            const uint64_t mean = (a | b) - (((a ^ b) >> 1u) & kLaneMask);
+            std::memcpy(pixels.data() + i, &mean, sizeof(mean));
+        }
+        for (; i < size; ++i)
+        {
+            const uint32_t a = current[i];
+            const uint32_t b = previous[i];
+            pixels[i] = static_cast<uint8_t>((a + b + 1u) >> 1u);
+        }
+    }
+};
