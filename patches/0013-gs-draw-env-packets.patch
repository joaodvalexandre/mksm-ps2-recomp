+        // MKSM: a normal-mode GIF transfer of qwc quadwords from addr (D2_MADR, D2_QWC, then D2_CHCR = 0x101), as
+        // libgraph's sceGsPutDrawEnv starts it.
+        void sendGifNormal(PS2Runtime *runtime, uint32_t addr, uint32_t qwc)
+        {
+            constexpr uint32_t GIF_CHANNEL = 0x1000A000u;
+            auto &mem = runtime->memory();
+            mem.writeIORegister(GIF_CHANNEL + 0x10u, toDmaPhys(addr));
+            mem.writeIORegister(GIF_CHANNEL + 0x20u, qwc & 0xFFFFu);
+            mem.writeIORegister(GIF_CHANNEL + 0x00u, 0x101u);
+            mem.processPendingTransfers();
+        }
+
+        // MKSM: the clear libgraph's sceGsSetDefClear writes: TEST_1 with the Z test always passing, a sprite of colour
+        // rgba (Q 1.0) from (x, y) to (x + w, y + h) at depth z, then TEST_1 from ztest.
+        void seedLibgraphClear(GsClearMem &clear, uint32_t ztest, int32_t x, int32_t y, int32_t w, int32_t h,
+                               uint32_t rgba, uint32_t z)
+        {
+            const auto xyz = [z](int32_t px, int32_t py)
+            {
+                return static_cast<uint64_t>(static_cast<uint16_t>(static_cast<uint32_t>(px) << 4u)) |
+                       (static_cast<uint64_t>(static_cast<uint16_t>(static_cast<uint32_t>(py) << 4u)) << 16u) |
+                       (static_cast<uint64_t>(z) << 32u);
+            };
+            clear.testa = {0x30000ull, GS_REG_TEST_1};
+            clear.prim = {static_cast<uint64_t>(GS_PRIM_SPRITE), GS_REG_PRIM};
+            clear.rgbaq = {static_cast<uint64_t>(rgba) | (0x3F800000ull << 32u), GS_REG_RGBAQ};
+            clear.xyz2a = {xyz(x, y), GS_REG_XYZ2};
+            clear.xyz2b = {xyz(x + w, y + h), GS_REG_XYZ2};
+            clear.testb = {makeTest(ztest), GS_REG_TEST_1};
+        }
+
+        // MKSM: libgraph's sceGszbufaddr(psm, w, h): the page after the frame buffers, w in 64-pixel units and h in
+        // 32-line units (64 for the 16-bit formats), twice that unless the display is interlaced in field mode.
+        int32_t gsZbufAddr(uint32_t psm, int32_t w, int32_t h)
+        {
+            const int32_t widthBlocks = (w + 63 < 0 ? w + 126 : w + 63) >> 6;
+            const int32_t heightBlocks = (psm & 2u) != 0u ? (h + 63 < 0 ? h + 126 : h + 63) >> 6
+                                                          : (h + 31 < 0 ? h + 62 : h + 31) >> 5;
+            const int32_t pages = widthBlocks * heightBlocks;
+            const bool interlacedField = g_gparam.interlace == 1u && g_gparam.ffmode == 0u;
+            return static_cast<int16_t>(interlacedField ? pages : pages * 2);
+        }
