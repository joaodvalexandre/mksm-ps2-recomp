+        // MKSM: blez/bgtz/bltz/bgez test the 64-bit register on the R5900. A game's table-of-contents decoder loads
+        // an 8-byte entry with ld and branches on bgez: with the low word tested instead, entries whose low word
+        // was positive took the wrong format path.
+        tc.Run("sign-test branches compare the whole 64-bit register", [](TestCase &t) {
+            R5900Decoder decoder;
+            Function func;
+            func.name = "sign_tests";
+            func.start = 0x1000;
+            func.end = 0x1030;
+            func.isRecompiled = true;
+            func.isStub = false;
+
+            std::vector<Instruction> instructions;
+            instructions.push_back(decoder.decodeInstruction(0x1000u, 0xDCE60000u)); // ld   $a2, 0($a3)
+            instructions.push_back(decoder.decodeInstruction(0x1004u, 0x04C10003u)); // bgez $a2, +3
+            instructions.push_back(decoder.decodeInstruction(0x1008u, 0x00000000u)); // nop (delay slot)
+            instructions.push_back(decoder.decodeInstruction(0x100Cu, 0x04E00002u)); // bltz $a3, +2
+            instructions.push_back(decoder.decodeInstruction(0x1010u, 0x00000000u)); // nop
+            instructions.push_back(decoder.decodeInstruction(0x1014u, 0x18800001u)); // blez $a0, +1
+            instructions.push_back(decoder.decodeInstruction(0x1018u, 0x00000000u)); // nop
+            instructions.push_back(decoder.decodeInstruction(0x101Cu, 0x1CA00001u)); // bgtz $a1, +1
+            instructions.push_back(decoder.decodeInstruction(0x1020u, 0x00000000u)); // nop
+            instructions.push_back(decoder.decodeInstruction(0x1024u, 0x03E00008u)); // jr $ra
+            instructions.push_back(decoder.decodeInstruction(0x1028u, 0x00000000u)); // nop
+
+            CodeGenerator gen({}, {});
+            const std::string generated = gen.generateFunction(func, instructions, false);
+            printGeneratedCode("sign-test branches compare the whole 64-bit register", generated);
+
+            t.IsTrue(generated.find("GPR_S64(ctx, 6) >= 0") != std::string::npos, "bgez must test the 64-bit value");
+            t.IsTrue(generated.find("GPR_S64(ctx, 7) < 0") != std::string::npos, "bltz must test the 64-bit value");
+            t.IsTrue(generated.find("GPR_S64(ctx, 4) <= 0") != std::string::npos, "blez must test the 64-bit value");
+            t.IsTrue(generated.find("GPR_S64(ctx, 5) > 0") != std::string::npos, "bgtz must test the 64-bit value");
+            t.IsTrue(generated.find("GPR_S32(ctx, 6) >= 0") == std::string::npos, "no 32-bit sign test may remain");
+        });
+
