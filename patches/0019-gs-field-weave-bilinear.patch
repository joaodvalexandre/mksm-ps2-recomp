+// MKSM: GsFieldBlend (runtime/gs/gs_field_blend.h).
+namespace
+{
+    // The per-byte mean of two groups of 8 bytes, rounded up: (a | b) - ((a ^ b) >> 1), each lane's shift kept to it.
+    inline uint64_t meanBytes(uint64_t a, uint64_t b)
+    {
+        return (a | b) - (((a ^ b) >> 1u) & 0x7F7F7F7F7F7F7F7Full);
+    }
+
+    inline uint64_t loadBytes(const uint8_t *p)
+    {
+        uint64_t value = 0u;
+        std::memcpy(&value, p, sizeof(value));
+        return value;
+    }
+
+    // How much a field placed between the rows of another combs: |row - (above + below) / 2| over the green byte of
+    // every fourth pixel.
+    uint64_t fieldCombing(const std::vector<uint8_t> &outer, const std::vector<uint8_t> &inner, size_t rowBytes,
+                          uint32_t rows)
+    {
+        uint64_t sum = 0u;
+        for (uint32_t row = 0u; row + 1u < rows; ++row)
+        {
+            const uint8_t *above = outer.data() + static_cast<size_t>(row) * rowBytes;
+            const uint8_t *below = above + rowBytes;
+            const uint8_t *between = inner.data() + static_cast<size_t>(row) * rowBytes;
+            for (size_t x = 1u; x < rowBytes; x += 16u)
+            {
+                const int expected = (static_cast<int>(above[x]) + static_cast<int>(below[x])) / 2;
+                const int difference = static_cast<int>(between[x]) - expected;
+                sum += static_cast<uint64_t>(difference < 0 ? -difference : difference);
+            }
+        }
+        return sum;
+    }
+}
+
+void GsFieldBlend::apply(std::vector<uint8_t> &pixels, uint32_t frameWidth, uint32_t &frameHeight, uint64_t displayBuffer,
+                         uint32_t maxHeight)
+{
+    const size_t rowBytes = static_cast<size_t>(frameWidth) * 4u;
+    const size_t fieldBytes = rowBytes * frameHeight;
+    if (fieldBytes == 0u || pixels.size() < fieldBytes)
+    {
+        fields = 0u;
+        return;
+    }
+    if (frameWidth != width || frameHeight != height)
+    {
+        width = frameWidth;
+        height = frameHeight;
+        fields = 0u;
+    }
+    const bool newField = fields == 0u || displayBuffer != buffer;
+    if (newField)
+    {
+        current.swap(previous); // the field shown so far becomes the previous one
+        fields = std::min<uint32_t>(fields + 1u, 2u);
+        buffer = displayBuffer;
+        heldLatches = 0u;
+    }
+    else if (heldLatches < kHeldLatches)
+    {
+        ++heldLatches;
+    }
+    current.assign(pixels.begin(), pixels.begin() + static_cast<std::ptrdiff_t>(fieldBytes));
+    if (fields == 2u && newField)
+    {
+        currentOnTop = fieldCombing(current, previous, rowBytes, height) <=
+                       fieldCombing(previous, current, rowBytes, height);
+    }
+    // one field, or one held on screen: each row twice
+    const std::vector<uint8_t> &other = fields == 2u && heldLatches < kHeldLatches ? previous : current;
+
+    const uint32_t rows = height * 2u;
+    if (rows > maxHeight)
+    {
+        // too tall to rebuild here: the per-byte mean of the two fields at field height
+        for (size_t i = 0u; i + 8u <= fieldBytes; i += 8u)
+        {
+            const uint64_t mean = meanBytes(loadBytes(current.data() + i), loadBytes(other.data() + i));
+            std::memcpy(pixels.data() + i, &mean, sizeof(mean));
+        }
+        for (size_t i = fieldBytes & ~static_cast<size_t>(7u); i < fieldBytes; ++i)
+        {
+            pixels[i] = static_cast<uint8_t>((current[i] + other[i] + 1u) >> 1u);
+        }
+        return;
+    }
+
+    const uint32_t topParity = currentOnTop ? 0u : 1u;
+    const auto wovenRow = [&](uint32_t row) -> const uint8_t *
+    {
+        const std::vector<uint8_t> &field = (row & 1u) == topParity ? current : other;
+        return field.data() + static_cast<size_t>(row >> 1u) * rowBytes;
+    };
+    pixels.resize(rowBytes * rows);
+    for (uint32_t row = 0u; row < rows; ++row)
+    {
+        const uint8_t *middle = wovenRow(row);
+        const uint8_t *above = wovenRow(row == 0u ? 0u : row - 1u);
+        const uint8_t *below = wovenRow(row + 1u < rows ? row + 1u : row);
+        uint8_t *out = pixels.data() + static_cast<size_t>(row) * rowBytes;
+        size_t x = 0u;
+        for (; x + 8u <= rowBytes; x += 8u)
+        {
+            const uint64_t value = meanBytes(meanBytes(loadBytes(above + x), loadBytes(below + x)), loadBytes(middle + x));
+            std::memcpy(out + x, &value, sizeof(value));
+        }
+        for (; x < rowBytes; ++x)
+        {
+            const uint32_t outer = (static_cast<uint32_t>(above[x]) + below[x] + 1u) >> 1u;
+            out[x] = static_cast<uint8_t>((outer + middle[x] + 1u) >> 1u);
+        }
+    }
+    frameHeight = rows;
+}
