 {
     accountCycles(cycles);
+    // MKSM: the EE clock must not fall behind the host clock. A guest loop that spends host time in each
+    // iteration (syscalls, locks) accounts only the checkpoint cycles, so a VBlank whose host deadline passed
+    // long ago would still be millions of cycles away, and a game waiting for its vsync callback (or for the
+    // threads that callback wakes) would wait forever. When the host deadline of the next event has passed, the
+    // cycle counter catches up to it; the timers and the IOP advance with it.
+    if ((++m_hostClockChecks & 63u) == 0u)
+    {
+        const uint64_t nextEventCycle = m_nextDeadlineCycle.load(std::memory_order_acquire);
+        const int64_t hostDeadlineNs = m_nextDeadlineHostNs.load(std::memory_order_acquire);
+        if (nextEventCycle != 0u && m_eeCycle < nextEventCycle && hostDeadlineNs != 0)
+        {
+            const int64_t nowNs = std::chrono::duration_cast<std::chrono::nanoseconds>(
+                                      std::chrono::steady_clock::now().time_since_epoch())
+                                      .count();
+            if (nowNs >= hostDeadlineNs)
+            {
+                uint64_t remaining = nextEventCycle - m_eeCycle;
+                while (remaining > 0u)
+                {
+                    const uint32_t step = static_cast<uint32_t>(std::min<uint64_t>(remaining, std::numeric_limits<uint32_t>::max()));
+                    accountCycles(step);
+                    remaining -= step;
+                }
+            }
+        }
+    }
 
