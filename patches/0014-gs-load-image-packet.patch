+        q[5] = GS_REG_TRXPOS;
+        q[6] = (bits(w) & 0xFFFFFFFFull) | (bits(h) << 32);
+        q[7] = GS_REG_TRXREG;
+        q[8] = 0ull; // host to local
+        q[9] = GS_REG_TRXDIR;
+        q[10] = (bits(qwc) & 0x7FFFull) | (1ull << 15) | (2ull << 58); // NLOOP, EOP, IMAGE
+        q[11] = 0ull;
+        std::memcpy(lp, q, sizeof(q));
