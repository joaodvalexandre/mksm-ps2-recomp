+        // MKSM: libgraph's sceGsLoadImage is the GIF packet itself (6 quadwords): a PACKED A+D tag (NLOOP 4, no EOP) with
+        // BITBLTBUF (DBP as given, in 64-word units), TRXPOS, TRXREG and TRXDIR (host to local), then the IMAGE tag (EOP)
+        // whose NLOOP is the image size in quadwords; it returns 6. The game also sends these packets in its own DMA
+        // chains, so a private record in their place (whose DBP sceGsExecLoadImage scaled by 8) made garbage uploads.
+        (void)runtime;
+        const uint32_t lpAddr = getRegU32(ctx, 4);
+        const GsSetDefImageArgs args = decodeGsSetDefImageArgs(rdram, ctx);
+        uint8_t *lp = getMemPtr(rdram, lpAddr);
+        // The arguments are shorts.
+        const int64_t dbp = static_cast<int16_t>(args.vramAddr);
+        const int64_t dbw = static_cast<int16_t>(args.vramWidth);
+        const int64_t dpsm = static_cast<int16_t>(args.psm);
+        const int64_t x = static_cast<int16_t>(args.x);
+        const int64_t y = static_cast<int16_t>(args.y);
+        const int64_t w = static_cast<int16_t>(args.width);
+        const int64_t h = static_cast<int16_t>(args.height);
+        int64_t qwc = 0;
+        switch (dpsm)
+        {
+        case GS_PSM_CT32:
+        case GS_PSM_Z32:
+            qwc = (w * h) >> 2;
+            break;
+        case GS_PSM_CT24:
+        case GS_PSM_Z24:
+            qwc = (w * h * 3) >> 4;
+            break;
+        case GS_PSM_CT16:
+        case GS_PSM_CT16S:
+        case GS_PSM_Z16:
+        case GS_PSM_Z16S:
+            qwc = (w * h) >> 3;
+            break;
+        case GS_PSM_T8:
+        case GS_PSM_T8H:
+            qwc = (w * h) >> 4;
+            break;
+        case GS_PSM_T4:
+        case GS_PSM_T4HL:
+        case GS_PSM_T4HH:
+            qwc = (w * h) >> 5;
+            break;
+        default:
+            break;
+        }
+        if (!lp || qwc > 0x7FFF)
