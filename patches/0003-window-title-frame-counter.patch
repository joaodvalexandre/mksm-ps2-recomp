diff --git b/ps2xRuntime/include/ps2_frame_counter.h b/ps2xRuntime/include/ps2_frame_counter.h
new file mode 100644
index 0000000..d0c858f
--- /dev/null
+++ b/ps2xRuntime/include/ps2_frame_counter.h
@@ -0,0 +1,95 @@
+#pragma once
+
+// MKSM: frame counter for the window title. A displayed frame is a vertical blank at which a display buffer register
+// (DISPFB1 or DISPFB2) differs from its value at the previous vertical blank. The registers change through several
+// paths (privileged register stores, the sceGsPutDispEnv and sceGsSwapDBuff handlers, GIF packets), so the counter
+// samples them once per vertical blank instead of hooking the writes; at most one flip per vblank can be seen anyway.
+
+#include <atomic>
+#include <cstdint>
+#include <cstdio>
+#include <string>
+
+namespace ps2_frame_counter
+{
+    struct State
+    {
+        std::atomic<uint64_t> frames{0};
+        uint64_t lastDispfb1 = 0;
+        uint64_t lastDispfb2 = 0;
+        bool primed = false;
+    };
+
+    inline State &state()
+    {
+        static State instance;
+        return instance;
+    }
+
+    // Before the EE thread starts.
+    inline void reset()
+    {
+        State &s = state();
+        s.frames.store(0u, std::memory_order_relaxed);
+        s.lastDispfb1 = 0;
+        s.lastDispfb2 = 0;
+        s.primed = false;
+    }
+
+    // Called by the EE scheduler at every vertical blank, on the EE thread.
+    inline void noteVBlank(uint64_t dispfb1, uint64_t dispfb2)
+    {
+        State &s = state();
+        if (s.primed && (dispfb1 != s.lastDispfb1 || dispfb2 != s.lastDispfb2))
+            s.frames.fetch_add(1u, std::memory_order_relaxed);
+        s.lastDispfb1 = dispfb1;
+        s.lastDispfb2 = dispfb2;
+        s.primed = true;
+    }
+
+    inline uint64_t displayedFrames()
+    {
+        return state().frames.load(std::memory_order_relaxed);
+    }
+
+    // "<base> | frame 1234 | 50.0 fps"
+    inline std::string windowTitle(const std::string &base, uint64_t frames, double fps)
+    {
+        char suffix[64];
+        std::snprintf(suffix, sizeof(suffix), " | frame %llu | %.1f fps",
+                      static_cast<unsigned long long>(frames), fps);
+        return base + suffix;
+    }
+
+    // Frame rate over the last refresh interval; refresh() returns true when the title should be updated.
+    class RateTracker
+    {
+    public:
+        bool refresh(uint64_t frames, double now, double interval = 0.5)
+        {
+            if (!m_started)
+            {
+                m_started = true;
+                m_lastFrames = frames;
+                m_lastTime = now;
+                return true;
+            }
+            const double elapsed = now - m_lastTime;
+            if (elapsed < interval)
+                return false;
+            const uint64_t advanced = frames >= m_lastFrames ? frames - m_lastFrames : 0u;
+            m_fps = elapsed > 0.0 ? static_cast<double>(advanced) / elapsed : 0.0;
+            m_lastFrames = frames;
+            m_lastTime = now;
+            return true;
+        }
+
+        double fps() const { return m_fps; }
+
+    private:
+        bool m_started = false;
+        uint64_t m_lastFrames = 0u;
+        double m_lastTime = 0.0;
+        double m_fps = 0.0;
+    };
+}
