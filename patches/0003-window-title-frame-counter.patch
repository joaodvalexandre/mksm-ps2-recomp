+        // MKSM: the window title frame counter counts the changes of the DISPFB registers (the buffer flips).
+        tc.Run("DISPFB changes count the displayed frames", [](TestCase &t)
+        {
+            PS2Memory mem;
+            t.IsTrue(mem.initialize(), "PS2Memory initialize should succeed");
+            ps2_frame_counter::reset();
+
+            const uint32_t dispfb1 = PS2_GS_PRIV_REG_BASE + ps2_frame_counter::kDispfb1Offset;
+            const uint32_t dispfb2 = PS2_GS_PRIV_REG_BASE + ps2_frame_counter::kDispfb2Offset;
+            const uint64_t initial = mem.read64(dispfb1);
+            mem.write64(dispfb1, initial);                 // same buffer again: not a flip
+            t.Equals(ps2_frame_counter::displayedFrames(), 0ull, "rewriting the same DISPFB value is not a frame");
+            mem.write64(dispfb1, initial ^ 0x50ull);       // another buffer
+            mem.write64(dispfb1, initial);                 // and back
+            mem.write32(dispfb1, static_cast<uint32_t>(initial ^ 0x50ull)); // low half through a 32-bit write
+            t.Equals(ps2_frame_counter::displayedFrames(), 3ull, "each DISPFB1 change is a displayed frame");
+            mem.write64(dispfb2, initial ^ 0x50ull);       // the other circuit is counted separately
+            t.Equals(ps2_frame_counter::displayedFrames(), 3ull, "the busier circuit is reported, not the sum");
+            mem.write64(PS2_GS_PRIV_REG_BASE + 0x80u, 0x1234ull); // DISPLAY1 is not a frame
+            t.Equals(ps2_frame_counter::displayedFrames(), 3ull, "other privileged registers do not count");
+
+            t.Equals(ps2_frame_counter::windowTitle("PS2-Recomp | X", 1234u, 49.96),
+                     std::string("PS2-Recomp | X | frame 1234 | 50.0 fps"), "title format");
+
+            ps2_frame_counter::RateTracker rate;
+            t.IsTrue(rate.refresh(0u, 10.0), "the first refresh updates the title");
+            t.IsFalse(rate.refresh(10u, 10.25), "no refresh before the interval has elapsed");
+            t.IsTrue(rate.refresh(30u, 11.0), "refresh after the interval");
+            t.Equals(rate.fps(), 30.0, "30 frames in one second");
+            ps2_frame_counter::reset();
+        });
+
