diff --git b/ps2xRuntime/include/ps2_frame_counter.h b/ps2xRuntime/include/ps2_frame_counter.h
new file mode 100644
index 0000000..7abe52c
--- /dev/null
+++ b/ps2xRuntime/include/ps2_frame_counter.h
@@ -0,0 +1,87 @@
+#pragma once
+
+// MKSM: frame counter for the window title. A displayed frame is a change of a DISPFB register (the guest's
+// display buffer flip); the two output circuits are counted separately and the busier one is reported, so a
+// game that writes both registers every frame is counted once per frame.
+
+#include <algorithm>
+#include <atomic>
+#include <cstdint>
+#include <cstdio>
+#include <string>
+
+namespace ps2_frame_counter
+{
+    constexpr uint32_t kDispfb1Offset = 0x0070u; // DISPFB1 in the GS privileged register block
+    constexpr uint32_t kDispfb2Offset = 0x0090u; // DISPFB2
+
+    inline std::atomic<uint64_t> &circuitFrames(unsigned circuit)
+    {
+        static std::atomic<uint64_t> counters[2]{};
+        return counters[circuit & 1u];
+    }
+
+    inline void reset()
+    {
+        circuitFrames(0).store(0u, std::memory_order_relaxed);
+        circuitFrames(1).store(0u, std::memory_order_relaxed);
+    }
+
+    // Called by the GS privileged register writes with the register offset and its value before and after.
+    inline void noteGsRegisterWrite(uint32_t regOff, uint64_t before, uint64_t after)
+    {
+        if (before == after)
+            return;
+        if (regOff == kDispfb1Offset)
+            circuitFrames(0).fetch_add(1u, std::memory_order_relaxed);
+        else if (regOff == kDispfb2Offset)
+            circuitFrames(1).fetch_add(1u, std::memory_order_relaxed);
+    }
+
+    inline uint64_t displayedFrames()
+    {
+        return std::max(circuitFrames(0).load(std::memory_order_relaxed),
+                        circuitFrames(1).load(std::memory_order_relaxed));
+    }
+
+    // "<base> | frame 1234 | 50.0 fps"
+    inline std::string windowTitle(const std::string &base, uint64_t frames, double fps)
+    {
+        char suffix[64];
+        std::snprintf(suffix, sizeof(suffix), " | frame %llu | %.1f fps",
+                      static_cast<unsigned long long>(frames), fps);
+        return base + suffix;
+    }
+
+    // Frame rate over the last refresh interval; refresh() returns true when the title should be updated.
+    class RateTracker
+    {
+    public:
+        bool refresh(uint64_t frames, double now, double interval = 0.5)
+        {
+            if (!m_started)
+            {
+                m_started = true;
+                m_lastFrames = frames;
+                m_lastTime = now;
+                return true;
+            }
+            const double elapsed = now - m_lastTime;
+            if (elapsed < interval)
+                return false;
+            const uint64_t advanced = frames >= m_lastFrames ? frames - m_lastFrames : 0u;
+            m_fps = elapsed > 0.0 ? static_cast<double>(advanced) / elapsed : 0.0;
+            m_lastFrames = frames;
+            m_lastTime = now;
+            return true;
+        }
+
+        double fps() const { return m_fps; }
+
+    private:
+        bool m_started = false;
+        uint64_t m_lastFrames = 0u;
+        double m_lastTime = 0.0;
+        double m_fps = 0.0;
+    };
+}
