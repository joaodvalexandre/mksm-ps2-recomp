diff --git a/ps2xRuntime/include/ps2_runtime.h b/ps2xRuntime/include/ps2_runtime.h
index 7161a70..c54def5 100644
--- a/ps2xRuntime/include/ps2_runtime.h
+++ b/ps2xRuntime/include/ps2_runtime.h
@@ -386,6 +386,9 @@ public:
     uint32_t guestHeapBase() const;
     uint32_t guestHeapEnd() const;
     uint32_t guestHeapLimit() const;
+    // MKSM-Port: the end of the heap the game configured (SetupHeap), 0 before it does; EndOfHeap reports it even
+    // when the runtime keeps its internal heap in a private range (setPrivateGuestHeap).
+    uint32_t gameHeapLimit() const;
     uint32_t reserveAsyncCallbackStack(uint32_t size, uint32_t alignment);
     // MKSM-Port: las pilas de interrupciones/callbacks se reservan desde lo alto de la RAM hacia abajo; este
     // limite las mantiene por debajo de la pila del hilo principal (que SetupThread coloca tambien arriba).
@@ -542,6 +545,7 @@ private:
     bool m_guestHeapConfigured = false;
     uint32_t m_privateGuestHeapBase = 0u;
     uint32_t m_privateGuestHeapLimit = 0u;
+    uint32_t m_gameHeapLimit = 0u; // MKSM-Port: see gameHeapLimit()
     uint32_t m_asyncCallbackStackFloor = 0x01F00000u;
     uint32_t m_asyncCallbackStackTop = PS2_RAM_SIZE;
 
diff --git a/ps2xRuntime/src/lib/Kernel/Syscalls/System.cpp b/ps2xRuntime/src/lib/Kernel/Syscalls/System.cpp
index ea00e23..46dbde3 100644
--- a/ps2xRuntime/src/lib/Kernel/Syscalls/System.cpp
+++ b/ps2xRuntime/src/lib/Kernel/Syscalls/System.cpp
@@ -598,9 +598,13 @@ namespace ps2_syscalls
 
         static constexpr uint32_t kDefaultGuestHeapEnd = 0x01F00000u;
 
-        const uint32_t ret = runtime
-                                 ? runtime->guestHeapLimit()
-                                 : kDefaultGuestHeapEnd;
+        // MKSM-Port: the end of the game's own heap (SetupHeap), not the runtime's: with a private runtime heap
+        // (setPrivateGuestHeap) its end is unrelated to the game, and a libc sbrk that checks heap_ptr + incr against
+        // EndOfHeap() failed every malloc (Mortal Kombat: Shaolin Monks built its GS packets at address 0).
+        const uint32_t gameLimit = runtime ? runtime->gameHeapLimit() : 0u;
+        const uint32_t ret = gameLimit != 0u ? gameLimit
+                             : runtime     ? runtime->guestHeapLimit()
+                                           : kDefaultGuestHeapEnd;
 
         setReturnU32(ctx, ret);
     }
