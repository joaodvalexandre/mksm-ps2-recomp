     void sceGsPutDrawEnv(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
     {
-        uint32_t envAddr = getRegU32(ctx, 4);
-        GsRegPairMem pairs[8]{};
-        if (!readGsRegPairs(rdram, envAddr, pairs, 8u))
+        // MKSM-Port: like libgraph, the argument is the GIF tag in front of the drawing environment (sceGsDBuff.giftag0,
+        // ...), and the tag with its NLOOP quadwords goes to the GS through PATH3: both contexts' registers and, when the
+        // game appends it, the clear sprite. Reading 8 register pairs from the tag itself applied the tag as a register,
+        // dropped TEST_1 and the whole context 2 and never cleared (Mortal Kombat: Shaolin Monks drew nothing visible).
+        const uint32_t tagAddr = getRegU32(ctx, 4);
+        const uint8_t *tag = getConstMemPtr(rdram, tagAddr);
+        if (!tag || !runtime || !runtime->syncCoreSubsystems())
         {
             setReturnS32(ctx, -1);
             return;
         }
-        applyGsRegPairs(runtime, pairs, 8u);
+        uint64_t tagLo = 0;
+        std::memcpy(&tagLo, tag, sizeof(tagLo));
+        const uint32_t nloop = static_cast<uint32_t>(tagLo & 0x7FFFu);
+        runtime->memory().sendDma(PS2Memory::DmaPath::Gif, tagAddr, nloop + 1u);
+        ps2_syscalls::dispatchDmacHandlersForCause(rdram, runtime, 2u);
         setReturnS32(ctx, 0);
     }
 
