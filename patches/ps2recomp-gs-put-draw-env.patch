                      "sceGsPutDispEnv should program DISPLAY2 from the display env");
         });
 
+        // MKSM-Port: sceGsPutDrawEnv takes the GIF tag in front of the drawing environment and sends the tag with all of
+        // its NLOOP register pairs (both contexts), not 8 pairs read from the tag itself.
+        tc.Run("sceGsPutDrawEnv sends the GIF tag with all of its register pairs", [](TestCase &t)
+        {
+            PS2Runtime runtime;
+            t.IsTrue(runtime.memory().initialize(), "runtime memory initialize should succeed");
+            uint8_t *rdram = runtime.memory().getRDRAM();
+
+            constexpr uint32_t kTagAddr = 0x4000u;
+            const uint64_t packet[] = {
+                10ull | (1ull << 15) | (1ull << 60), 0xEull, // PACKED A+D tag, EOP, NLOOP 10
+                (10ull << 16), GS_REG_FRAME_1,               // FBP 0, FBW 10
+                0ull, GS_REG_ZBUF_1,
+                (0x6C00ull | (0x7800ull << 32)), GS_REG_XYOFFSET_1,
+                ((639ull << 16) | (255ull << 48)), GS_REG_SCISSOR_1,
+                1ull, GS_REG_PRMODECONT,
+                1ull, GS_REG_COLCLAMP,
+                0ull, GS_REG_DTHE,
+                0x3000Bull, GS_REG_TEST_1,                   // ATE, ATST GEQUAL, ZTE, ZTST ALWAYS
+                (0x50ull | (10ull << 16)), GS_REG_FRAME_2,   // FBP 0x50, FBW 10
+                0x30000ull, GS_REG_TEST_2,
+            };
+            std::memcpy(rdram + kTagAddr, packet, sizeof(packet));
+
+            R5900Context ctx{};
+            setRegU32(ctx, 4, kTagAddr);
+            ps2_stubs::sceGsPutDrawEnv(rdram, &ctx, &runtime);
+            t.Equals(static_cast<int32_t>(getRegU32Test(ctx, 2)), 0, "sceGsPutDrawEnv should succeed");
+
+            const GSDebugSnapshot snap = runtime.gs().getDebugSnapshot();
+            t.Equals(snap.ctx[0].frame.fbw, 10u, "FRAME_1 should come from the first pair after the tag");
+            t.Equals(snap.ctx[0].test, 0x3000Bull, "TEST_1, the eighth pair, should reach the GS");
+            t.Equals(snap.ctx[1].frame.fbp, 0x50u, "FRAME_2 should reach the GS (context 2 of the environment)");
+            t.Equals(snap.ctx[1].test, 0x30000ull, "TEST_2, the last pair (NLOOP 10), should reach the GS");
+        });
+
 
 
 
