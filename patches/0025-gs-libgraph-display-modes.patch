+    // MKSM: the DISPLAY register libgraph computes for a picture of width x height (upstream's
+    // feature/performance-patch-1, makeDefaultGsDispEnv). In the analog video modes (NTSC 2, PAL 3) DX, DY, DW and DH
+    // count output clocks and raster lines: 640 pixels span 2560 clocks (MAGH 3), the picture starts where the TV's
+    // does, and in interlaced frame mode (FFMD) DH counts the lines of both fields. Other modes keep the pixel values.
+    static uint64_t makeLibgraphDisplay(uint32_t width, uint32_t height, int32_t dx = 0, int32_t dy = 0)
+    {
+        if (width == 0u)
+            width = 640u;
+        if (height == 0u)
+            height = 448u;
+        if (g_gparam.omode == 2u || g_gparam.omode == 3u)
+        {
+            const uint32_t magnification = std::max(1u, (width + 2559u) / width);
+            const int32_t originX = g_gparam.omode == 2u ? 636 : 656;
+            const int32_t originY = g_gparam.omode == 2u ? 25 : 36;
+            const uint32_t lines = (g_gparam.interlace && g_gparam.ffmode) ? height * 2u : height;
+            return makeDisplay(static_cast<uint32_t>(originX + dx * static_cast<int32_t>(magnification)),
+                               static_cast<uint32_t>(originY * (g_gparam.interlace ? 2 : 1) + dy),
+                               magnification - 1u, 0u, width * magnification - 1u, lines - 1u);
+        }
+        return makeDisplay(static_cast<uint32_t>(dx), static_cast<uint32_t>(dy), 0u, 0u, width - 1u, height - 1u);
+    }
