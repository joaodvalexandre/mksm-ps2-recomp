+// MKSM: the VU divider in macro mode, as the VU computes (PCSX2 _vuDIV, _vuSQRT, _vuRSQRT; the runtime's VU
+// interpreter does the same in micro mode). An operand with exponent 0 is zero and one with exponent 255 the largest
+// number; a zero divisor gives the largest number with the sign of fs xor ft (of fs alone for RSQRT); the root is of the
+// magnitude; the result is saturated and flushed. The status register gets the invalid (bit 4: 0/0, a negative
+// radicand) and division by zero (bit 5) flags of this instruction and their sticky copies (bits 10, 11).
+inline float ps2_vu_operand(float value)
+{
+    const uint32_t bits = std::bit_cast<uint32_t>(value);
+    const uint32_t exponent = bits & 0x7F800000u;
+    if (exponent == 0u)
+        return std::bit_cast<float>(bits & 0x80000000u);
+    if (exponent == 0x7F800000u)
+        return std::bit_cast<float>((bits & 0x80000000u) | 0x7F7FFFFFu);
+    return value;
+}
+
+inline void ps2_vu0_set_divide_flags(R5900Context *ctx, uint32_t flags)
+{
+    ctx->vu0_status = static_cast<uint16_t>((ctx->vu0_status & 0xFCFu) | flags | (flags << 6));
+}
+
+inline void ps2_vu0_div(R5900Context *ctx, float fs, float ft)
+{
+    const float numerator = ps2_vu_operand(fs);
+    const float divisor = ps2_vu_operand(ft);
+    if (divisor == 0.0f)
+    {
+        ps2_vu0_set_divide_flags(ctx, numerator == 0.0f ? 0x10u : 0x20u);
+        const uint32_t sign = (std::bit_cast<uint32_t>(numerator) ^ std::bit_cast<uint32_t>(divisor)) & 0x80000000u;
+        ctx->vu0_q = std::bit_cast<float>(sign | 0x7F7FFFFFu);
+        return;
+    }
+    ps2_vu0_set_divide_flags(ctx, 0u);
+    ctx->vu0_q = ps2_vu_operand(numerator / divisor);
+}
+
+inline void ps2_vu0_sqrt(R5900Context *ctx, float ft)
+{
+    const float radicand = ps2_vu_operand(ft);
+    ps2_vu0_set_divide_flags(ctx, radicand < 0.0f ? 0x10u : 0u);
+    ctx->vu0_q = std::sqrt(std::fabs(radicand));
+}
+
+inline void ps2_vu0_rsqrt(R5900Context *ctx, float fs, float ft)
+{
+    const float numerator = ps2_vu_operand(fs);
+    const float radicand = ps2_vu_operand(ft);
+    const float root = std::sqrt(std::fabs(radicand));
+    if (root == 0.0f)
+    {
+        ps2_vu0_set_divide_flags(ctx, numerator == 0.0f ? 0x10u : 0x20u);
+        ctx->vu0_q = std::bit_cast<float>((std::bit_cast<uint32_t>(numerator) & 0x80000000u) | 0x7F7FFFFFu);
+        return;
+    }
+    ps2_vu0_set_divide_flags(ctx, radicand < 0.0f ? 0x10u : 0u);
+    ctx->vu0_q = ps2_vu_operand(numerator / root);
+}
+
+// MKSM: FTOI saturates: cvttps2dq gives 0x80000000 for everything out of range, the VU gives 0x7FFFFFFF for the
+// positive values (patterns of 2^31 and above, exponent 255 included) and 0x80000000 for the negative ones.
+inline __m128i ps2_vu_ftoi(__m128 scaled)
+{
+    const __m128i truncated = _mm_cvttps_epi32(scaled);
+    return _mm_xor_si128(truncated, _mm_cmpgt_epi32(_mm_castps_si128(scaled), _mm_set1_epi32(0x4EFFFFFF)));
+}
+
+// MKSM: the comparisons of CLIP as the VU makes them: on the bit patterns, with |w| (a w with exponent 0 limits like
+// the largest such number). `above` has bit n set when lane n is greater than +|w|, `below` when it is less than -|w|.
+inline void ps2_vu_clip_masks(__m128 fs, __m128 ft, uint32_t &above, uint32_t &below)
+{
+    const __m128i w = _mm_castps_si128(_mm_shuffle_ps(ft, ft, _MM_SHUFFLE(3, 3, 3, 3)));
+    const __m128i limit = _mm_max_epi32(_mm_and_si128(w, _mm_set1_epi32(0x7FFFFFFF)), _mm_set1_epi32(0x007FFFFF));
+    const __m128i bits = _mm_castps_si128(fs);
+    above = static_cast<uint32_t>(_mm_movemask_ps(_mm_castsi128_ps(_mm_cmpgt_epi32(bits, limit))));
+    below = static_cast<uint32_t>(_mm_movemask_ps(_mm_castsi128_ps(
+        _mm_cmpgt_epi32(_mm_xor_si128(bits, _mm_set1_epi32(static_cast<int>(0x80000000u))), limit))));
+}
+
+// MKSM: MAX and MINI as the VU computes them (PCSX2 fp_max/fp_min, microVU's integer path): the bit patterns compared
+// as sign and magnitude, so a pattern with exponent 255 is an ordinary large number and -0 is below +0. maxps and minps
+// return their second operand whenever one is such a pattern (a NaN for the host) or both are zeros.
+inline __m128i ps2_vu_order_key(__m128 value) // sign and magnitude to two's complement order
+{
+    const __m128i bits = _mm_castps_si128(value);
+    return _mm_xor_si128(bits, _mm_srli_epi32(_mm_srai_epi32(bits, 31), 1));
+}
+
+inline __m128 ps2_vmax(__m128 a, __m128 b)
+{
+    return _mm_blendv_ps(b, a, _mm_castsi128_ps(_mm_cmpgt_epi32(ps2_vu_order_key(a), ps2_vu_order_key(b))));
+}
+
+inline __m128 ps2_vmini(__m128 a, __m128 b)
+{
+    return _mm_blendv_ps(a, b, _mm_castsi128_ps(_mm_cmpgt_epi32(ps2_vu_order_key(a), ps2_vu_order_key(b))));
+}
