-#define FPU_CVT_W_S(a) ((int32_t)nearbyintf((float)(a)))
+// MKSM: CVT.W.S on the EE always truncates toward zero (the EE FPU has no other rounding mode) and saturates
+// values whose magnitude is 2^31 or more (exponent field above 0x9D, which includes Inf/NaN bit patterns) to
+// INT32_MAX or INT32_MIN by sign, as PCSX2 does. nearbyintf rounded to nearest: x.5 and above came out one higher.
+static inline int32_t ps2_cvt_w_s(float value)
+{
+    uint32_t bits;
+    std::memcpy(&bits, &value, sizeof(bits));
+    if ((bits & 0x7F800000u) <= 0x4E800000u)
+        return static_cast<int32_t>(value);
+    return (bits & 0x80000000u) ? static_cast<int32_t>(0x80000000u) : 0x7FFFFFFF;
+}
+#define FPU_CVT_W_S(a) ps2_cvt_w_s((float)(a))
 #define FPU_CVT_L_S(a) ((int64_t)(float)(a))
