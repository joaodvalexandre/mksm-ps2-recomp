-#define PS2_PROT3W(rs) _mm_shuffle_epi32(rs, _MM_SHUFFLE(0, 3, 2, 1))
+// MKSM: PEXEH exchanges halfwords 0 and 2 of each doubleword, PEXEW words 0 and 2, PROT3W rotates the low three
+// words (w0 <- w1, w1 <- w2, w2 <- w0) and keeps w3. The shuffles used to swap adjacent pairs and rotate all four.
+#define PS2_PEXEH(rs) _mm_shufflelo_epi16(_mm_shufflehi_epi16(rs, _MM_SHUFFLE(3, 0, 1, 2)), _MM_SHUFFLE(3, 0, 1, 2))
+#define PS2_PEXEW(rs) _mm_shuffle_epi32(rs, _MM_SHUFFLE(3, 0, 1, 2))
+#define PS2_PROT3W(rs) _mm_shuffle_epi32(rs, _MM_SHUFFLE(3, 0, 2, 1))
+
+// MKSM: PHMADH: rd word i = rs.h(2i+1) * rt.h(2i+1) + rs.h(2i) * rt.h(2i) (32-bit, wrapping). LO receives the
+// sums of words 0 and 2 in its words 0 and 2, HI those of words 1 and 3; the odd words of LO/HI hold the
+// product of the odd halfwords, as in PCSX2.
+static inline __m128i ps2_phmadh(__m128i rs, __m128i rt, uint64_t &lo, uint64_t &hi, uint64_t &lo1, uint64_t &hi1)
+{
+    alignas(16) int16_t a[8];
+    alignas(16) int16_t b[8];
+    _mm_store_si128(reinterpret_cast<__m128i *>(a), rs);
+    _mm_store_si128(reinterpret_cast<__m128i *>(b), rt);
+    uint32_t sums[4];
+    uint32_t odd[4];
+    for (int i = 0; i < 4; ++i)
+    {
+        odd[i] = static_cast<uint32_t>(static_cast<int32_t>(a[2 * i + 1]) * static_cast<int32_t>(b[2 * i + 1]));
+        const uint32_t even = static_cast<uint32_t>(static_cast<int32_t>(a[2 * i]) * static_cast<int32_t>(b[2 * i]));
+        sums[i] = odd[i] + even;
+    }
+    lo = static_cast<uint64_t>(sums[0]) | (static_cast<uint64_t>(odd[0]) << 32);
+    hi = static_cast<uint64_t>(sums[1]) | (static_cast<uint64_t>(odd[1]) << 32);
+    lo1 = static_cast<uint64_t>(sums[2]) | (static_cast<uint64_t>(odd[2]) << 32);
+    hi1 = static_cast<uint64_t>(sums[3]) | (static_cast<uint64_t>(odd[3]) << 32);
+    return _mm_setr_epi32(static_cast<int32_t>(sums[0]), static_cast<int32_t>(sums[1]),
+                          static_cast<int32_t>(sums[2]), static_cast<int32_t>(sums[3]));
+}
 
 // Additional VU0 operations
 #define PS2_VSQRT(x) sqrtf(x)
