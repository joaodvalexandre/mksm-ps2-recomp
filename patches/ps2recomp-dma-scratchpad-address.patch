+// MKSM-Port: an address as the DMAC reads it (D_MADR, D_TADR, the ADDR of a DMA tag): bit 31 (SPR) selects the
+// scratchpad, at the quadword offset in bits 4-13; any other address is main memory. For the EE, 0x80000000 is kseg0.
+inline uint32_t ps2DmaAddress(uint32_t value)
+{
+    return (value & 0x80000000u) != 0u ? PS2_SCRATCHPAD_BASE + (value & 0x3FF0u) : value;
+}
