+        // MKSM-Port: the GS clamps a vertex Z to its Z buffer format. Shaolin Monks draws its menu layers with Z
+        // 0x199999A0, 0x40000000 and 0x7FFFFFFF over a Z24 buffer (GEQUAL, never cleared): clamped, every layer passes;
+        // with only the low 24 bits kept they became 0.6, 0 and 1 and the old screens showed through the menu.
+        tc.Run("vertex Z is clamped to the Z buffer format, not wrapped", [](TestCase &t)
+        {
+            constexpr double kZ32 = 4294967295.0, kZ24 = 16777215.0, kZ16 = 65535.0;
+            const auto near = [](float value, double expected) { return std::fabs(value - expected) < 1e-6; };
+            t.IsTrue(near(gsHwDepthToUnit(0x199999A0, kZ24), 1.0), "Z24: 0x199999A0 should clamp to the deepest value");
+            t.IsTrue(near(gsHwDepthToUnit(0x40000000, kZ24), 1.0), "Z24: 0x40000000 should clamp, not wrap to 0");
+            t.IsTrue(near(gsHwDepthToUnit(0x7FFFFFFF, kZ24), 1.0), "Z24: 0x7FFFFFFF should clamp to the deepest value");
+            t.IsTrue(near(gsHwDepthToUnit(0x10000, kZ16), 1.0), "Z16: 0x10000 should clamp, not wrap to 0");
+            t.IsTrue(near(gsHwDepthToUnit(0x800000, kZ24), 0x800000 / kZ24), "Z24 values in range keep their depth");
+            t.IsTrue(near(gsHwDepthToUnit(0x40000000, kZ32), 0x40000000 / kZ32), "Z32 keeps all 32 bits");
+            t.IsTrue(near(gsHwDepthToUnit(-1.0, kZ24), 0.0), "negative Z is depth 0");
+        });
