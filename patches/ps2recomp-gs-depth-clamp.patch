--- a/ps2xRuntime/include/runtime/gs/gs_hw_backend.h
+++ b/ps2xRuntime/include/runtime/gs/gs_hw_backend.h
@@ -6,8 +6,18 @@
 
 #include "runtime/gs/gs_backend.h"
 
+#include <algorithm>
 #include <memory>
 
+// MKSM-Port: a vertex Z as a depth in [0, 1] of its Z buffer format's range (zmax: 0xFFFFFFFF, 0xFFFFFF or 0xFFFF). The
+// GS clamps a Z larger than the format holds to that maximum, as PCSX2 does (its zclamp); keeping only the low bits
+// turned Shaolin Monks' menu sprites (Z 0x40000000 and 0x7FFFFFFF over a Z24 buffer) into depths 0 and 1, and the
+// layers that then failed the GEQUAL test left the previous screens' pixels on the menu.
+inline float gsHwDepthToUnit(double z, double zmax)
+{
+    return static_cast<float>(std::min(std::max(z, 0.0), zmax) / zmax);
+}
+
 class GSHwBackend final : public GSRasterBackend
 {
 public:
