diff --git a/ps2xRuntime/include/ps2_host_aspect.h b/ps2xRuntime/include/ps2_host_aspect.h
new file mode 100644
index 0000000..b14b302
--- /dev/null
+++ b/ps2xRuntime/include/ps2_host_aspect.h
@@ -0,0 +1,30 @@
+#pragma once
+
+#include <algorithm>
+
+// MKSM: where the host window shows the PS2 picture. PS2 frames do not have square pixels (a 640x448 frame is a 4:3
+// picture on a TV), so the frame is shown at a display aspect, as large as the window allows and centred in it
+// (letterboxed or pillarboxed). An aspect of 0 or less fills the window, whatever its shape.
+struct Ps2HostPictureRect
+{
+    float x = 0.0f;
+    float y = 0.0f;
+    float width = 0.0f;
+    float height = 0.0f;
+};
+
+inline Ps2HostPictureRect ps2HostPictureRect(float windowWidth, float windowHeight, float aspect)
+{
+    Ps2HostPictureRect rect;
+    rect.width = std::max(windowWidth, 0.0f);
+    rect.height = std::max(windowHeight, 0.0f);
+    if (aspect <= 0.0f || rect.width <= 0.0f || rect.height <= 0.0f)
+    {
+        return rect;
+    }
+    rect.width = std::min(rect.width, rect.height * aspect);
+    rect.height = rect.width / aspect;
+    rect.x = (windowWidth - rect.width) * 0.5f;
+    rect.y = (windowHeight - rect.height) * 0.5f;
+    return rect;
+}
