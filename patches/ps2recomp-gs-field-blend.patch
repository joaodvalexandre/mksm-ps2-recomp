     return static_cast<float>(std::min(std::max(z, 0.0), zmax) / zmax);
 }
 
+// MKSM-Port: field rendering (SMODE2 INT and FFMD) is shown as the mean of each field and the one before, as a TV's
+// persistence shows it (PCSX2's "blend" deinterlacing); setting is MKSM_DEINTERLACE, "0" shows the fields one by one.
+inline bool gsHwBlendFields(uint64_t smode2, const char *setting)
+{
+    return (smode2 & 3u) == 3u && !(setting != nullptr && setting[0] == '0');
+}
+
 class GSHwBackend final : public GSRasterBackend
 {
 public:
