+    // MKSM: MKSM_CRASH_TRACE=1 prints the faulting thread's stack, with symbols from the runner's PDB, when the process
+    // crashes ([gs-crash] lines): AMD's Vulkan driver crashed (amdvlk64.dll, 0xC0000005) one to two minutes in.
+    LONG WINAPI crashTrace(EXCEPTION_POINTERS *info)
+    {
+        HANDLE process = GetCurrentProcess();
+        HANDLE thread = GetCurrentThread();
+        SymSetOptions(SYMOPT_UNDNAME | SYMOPT_DEFERRED_LOADS | SYMOPT_LOAD_LINES);
+        SymInitialize(process, nullptr, TRUE);
+        CONTEXT context = *info->ContextRecord;
+        std::fprintf(stderr, "[gs-crash] exception 0x%08lX at %p, thread %lu" "\n",
+                     info->ExceptionRecord->ExceptionCode, info->ExceptionRecord->ExceptionAddress, GetCurrentThreadId());
+        if (info->ExceptionRecord->ExceptionCode == EXCEPTION_ACCESS_VIOLATION && info->ExceptionRecord->NumberParameters >= 2)
+            std::fprintf(stderr, "[gs-crash] %s address 0x%llX" "\n",
+                         info->ExceptionRecord->ExceptionInformation[0] ? "writing" : "reading",
+                         static_cast<unsigned long long>(info->ExceptionRecord->ExceptionInformation[1]));
+        STACKFRAME64 frame{};
+        frame.AddrPC.Offset = context.Rip;
+        frame.AddrPC.Mode = AddrModeFlat;
+        frame.AddrFrame.Offset = context.Rbp;
+        frame.AddrFrame.Mode = AddrModeFlat;
+        frame.AddrStack.Offset = context.Rsp;
+        frame.AddrStack.Mode = AddrModeFlat;
+        for (int depth = 0; depth < 48; ++depth)
+        {
+            if (!StackWalk64(IMAGE_FILE_MACHINE_AMD64, process, thread, &frame, &context, nullptr, SymFunctionTableAccess64,
+                             SymGetModuleBase64, nullptr) || frame.AddrPC.Offset == 0)
+                break;
+            const DWORD64 pc = frame.AddrPC.Offset;
+            const DWORD64 base = SymGetModuleBase64(process, pc);
+            char module[MAX_PATH] = "?";
+            if (base)
+                GetModuleFileNameA(reinterpret_cast<HMODULE>(base), module, MAX_PATH);
+            const char *moduleName = std::strrchr(module, '\\') ? std::strrchr(module, '\\') + 1 : module;
+            alignas(SYMBOL_INFO) char buffer[sizeof(SYMBOL_INFO) + 512];
+            auto *symbol = reinterpret_cast<SYMBOL_INFO *>(buffer);
+            symbol->SizeOfStruct = sizeof(SYMBOL_INFO);
+            symbol->MaxNameLen = 511;
+            DWORD64 displacement = 0;
+            const bool named = SymFromAddr(process, pc, &displacement, symbol) != FALSE;
+            std::fprintf(stderr, "[gs-crash] #%02d %s+0x%llX %s+0x%llX" "\n", depth, moduleName,
+                         static_cast<unsigned long long>(pc - base), named ? symbol->Name : "?",
+                         static_cast<unsigned long long>(displacement));
+        }
+        std::fflush(stderr);
+        return EXCEPTION_CONTINUE_SEARCH;
+    }
