+                case 16: samples = ParallelGS::SuperSampling::X16; break;
+                case 4: samples = ParallelGS::SuperSampling::X4; break;
+                default: samples = ParallelGS::SuperSampling::X1; break;
+                }
+            }
+            if (const char *progressiveSetting = std::getenv("PS2X_GS_PROGRESSIVE"))
+                progressive = std::atoi(progressiveSetting) != 0;
+            if (const char *phase = std::getenv("PS2X_GS_FIELD_PHASE"))
