+        VulkanDevice()
+        {
+            if (!Vulkan::Context::init_loader(nullptr))
+                throw std::runtime_error("parallel-gs: Vulkan loader unavailable");
+            context.set_num_thread_indices(1);
+            if (!context.init_instance_and_device(nullptr, 0, nullptr, 0))
+                throw std::runtime_error("parallel-gs: Vulkan device initialization failed");
+            device.set_context(context);
+            device.init_frame_contexts(8); // paraLLEl-GS flushes often: two made each flush wait for the GPU
+            device.next_frame_context();
+        }
+    };
