+        // which skips and repeats fields.
+        void VBlank(const GSPresentationRequest &request) override
+        {
+            Lock lock(mutex);
+            gs.flush();
+            auto &p = gs.get_priv_register_state();
+            p.qwords_lo[0] = request.pmode;
+            p.qwords_lo[2] = request.smode1;
+            p.qwords_lo[4] = request.smode2;
+            p.qwords_lo[12] = request.syncv;
+            p.qwords_lo[14] = request.dispfb1;
+            p.qwords_lo[16] = request.display1;
+            p.qwords_lo[18] = request.dispfb2;
+            p.qwords_lo[20] = request.display2;
+            p.qwords_lo[28] = request.bgcolor;
+            ParallelGS::VSyncInfo info{};
+            info.phase = request.field ^ (settings.flipPhase ? 1u : 0u);
+            // MKSM: the library's own layout, which every scanout path ends in (upstream asked for TRANSFER_SRC, which
+            // the interlaced and high-resolution paths leave in READ_ONLY_OPTIMAL); the copy below moves it on.
+            info.dst_layout = VK_IMAGE_LAYOUT_READ_ONLY_OPTIMAL;
+            info.dst_stage = VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT;
+            info.dst_access = VK_ACCESS_2_SHADER_SAMPLED_READ_BIT;
+            // MKSM: off: libgraph's PAL origin (DX 656) against paraLLEl-GS's (169 x 4) moved the picture 5 pixels left.
+            info.crtc_offsets = false;
+            // MKSM: the progressive, super-sampled picture (PictureSettings); otherwise the raw fields of interlaced
+            // frame mode for the frontend's weave, and paraLLEl-GS's own deinterlacer for the other interlaced modes.
+            const bool fieldRendered = (request.smode2 & 3u) == 3u;
+            const bool progressive = settings.progressive && request.deinterlace;
+            info.force_progressive = progressive;
+            info.high_resolution_scanout = progressive;
+            info.anti_blur = progressive;
+            info.skip_deinterlace = !progressive && (fieldRendered || !request.deinterlace);
+            const auto scanout = gs.vsync(info);
+            if (!scanout.image)
+            {
+                latest = -1; // nothing on screen (display off, no read circuit)
+                return;
+            }
+            if (scanout.image->get_format() != VK_FORMAT_R8G8B8A8_UNORM)
+                throw std::runtime_error("parallel-gs: unexpected scanout format");
+
+            Picture &slot = pictures[next];
+            if (slot.fence)
+            {
+                slot.fence->wait(); // three fields ago: done long since
+                slot.fence.reset();
+            }
+            slot.width = scanout.image->get_width();
+            slot.height = scanout.image->get_height();
+            const VkDeviceSize bytes = VkDeviceSize(slot.width) * slot.height * 4u;
+            if (!slot.buffer || slot.capacity < bytes)
+            {
+                Vulkan::BufferCreateInfo buffer{};
+                buffer.domain = Vulkan::BufferDomain::CachedHost;
+                buffer.size = bytes;
+                buffer.usage = VK_BUFFER_USAGE_TRANSFER_DST_BIT;
+                slot.buffer = vulkan.device.create_buffer(buffer);
+                slot.capacity = slot.buffer ? bytes : 0;
+                if (!slot.buffer)
+                    throw std::runtime_error("parallel-gs: readback buffer allocation failed");
+            }
+            auto cmd = vulkan.device.request_command_buffer();
+            cmd->image_barrier(*scanout.image, VK_IMAGE_LAYOUT_READ_ONLY_OPTIMAL, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+                               VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT, 0, // whatever pass wrote it last
+                               VK_PIPELINE_STAGE_2_COPY_BIT, VK_ACCESS_2_TRANSFER_READ_BIT);
+            cmd->copy_image_to_buffer(*slot.buffer, *scanout.image, 0, {0, 0, 0}, {slot.width, slot.height, 1}, 0, 0,
+                                      {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1});
+            cmd->barrier(VK_PIPELINE_STAGE_2_COPY_BIT, VK_ACCESS_2_TRANSFER_WRITE_BIT,
+                         VK_PIPELINE_STAGE_HOST_BIT, VK_ACCESS_2_HOST_READ_BIT);
+            vulkan.device.submit(cmd, &slot.fence);
+            slot.sequence = ++scanouts;
+            slot.deinterlaced = !info.skip_deinterlace;
+            slot.parity = info.phase;
+            slot.displayBuffer = (request.pmode & 2u) != 0u ? request.dispfb2 : request.dispfb1;
+            latest = next;
+            next = (next + 1) % int(pictures.size());
+        }
+
+        // MKSM: the host thread's copy of the last picture scanned out (VBlank), presented like the CPU backend's.
+        PresentationFrame Present(const GSPresentationRequest &) override
+        {
+            Vulkan::Fence fence;
+            Vulkan::Fence previousFence;
+            int index = -1;
+            int previousIndex = -1;
+            uint64_t sequence = 0;
+            {
+                Lock lock(mutex);
+                if (latest < 0)
+                    return {};
+                index = latest;
+                fence = pictures[index].fence;
+                sequence = pictures[index].sequence;
+                // MKSM: the field just before it, for the frontend's weave
+                const int before = (index + int(pictures.size()) - 1) % int(pictures.size());
+                if (pictures[before].sequence + 1u == sequence && pictures[before].buffer &&
+                    pictures[before].width == pictures[index].width && pictures[before].height == pictures[index].height)
+                {
+                    previousIndex = before;
+                    previousFence = pictures[before].fence;
+                }
+            }
+            if (previousFence)
+                previousFence->wait();
+            if (fence)
+                fence->wait(); // without the lock: the game thread goes on meanwhile
+            PresentationFrame frame;
+            {
+                Lock lock(mutex);
+                fence.reset();
+                previousFence.reset();
+                const Picture &slot = pictures[index];
+                if (slot.sequence != sequence || !slot.buffer) // reused meanwhile (the host fell three fields behind)
+                    return {};
+                const auto *mapped = static_cast<const uint8_t *>(
+                    vulkan.device.map_host_buffer(*slot.buffer, Vulkan::MEMORY_ACCESS_READ_BIT));
+                if (!mapped)
+                    return {};
+                frame.pixels.assign(mapped, mapped + size_t(slot.width) * slot.height * 4u);
+                vulkan.device.unmap_host_buffer(*slot.buffer, Vulkan::MEMORY_ACCESS_READ_BIT);
+                frame.width = slot.width;
+                frame.height = slot.height;
+                frame.deinterlaced = slot.deinterlaced;
+                frame.fieldSequence = slot.sequence;
+                frame.fieldParity = slot.parity;
+                frame.fieldBuffer = slot.displayBuffer;
+                if (previousIndex >= 0 && pictures[previousIndex].sequence + 1u == sequence)
+                {
+                    const Picture &before = pictures[previousIndex];
+                    const auto *previous = static_cast<const uint8_t *>(
+                        vulkan.device.map_host_buffer(*before.buffer, Vulkan::MEMORY_ACCESS_READ_BIT));
+                    if (previous)
+                    {
+                        frame.previousPixels.assign(previous, previous + size_t(before.width) * before.height * 4u);
+                        vulkan.device.unmap_host_buffer(*before.buffer, Vulkan::MEMORY_ACCESS_READ_BIT);
+                        frame.previousParity = before.parity;
+                        frame.previousBuffer = before.displayBuffer;
+                    }
+                }
+            }
+            for (size_t i = 3; i < frame.previousPixels.size(); i += 4)
+                frame.previousPixels[i] = 0xFF;
+            for (size_t i = 3; i < frame.pixels.size(); i += 4)
+                frame.pixels[i] = 0xFF; // opaque, as the CPU backend presents
+            return frame;
+        }
+
+        uint32_t ReadVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y) const override
+        {
+            Lock lock(mutex);
+            auto *mapped = const_cast<uint8_t *>(static_cast<const uint8_t *>(gs.map_vram_read(0, VramSize)));
+            ++readbacks;
+            return pixelAccess(psm).read(mapped, base, bw, x, y);
+        }
+
+        void WriteVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y, uint32_t value) override
+        {
+            Lock lock(mutex);
+            gs.map_vram_read(0, VramSize); // Preserve untouched pixels and packed-format lanes.
+            auto *mapped = static_cast<uint8_t *>(gs.map_vram_write(0, VramSize));
+            ++readbacks;
+            pixelAccess(psm).write(mapped, base, bw, x, y, value);
+            gs.end_vram_write(0, VramSize);
+        }
+
+        void SnapshotVram(std::vector<uint8_t> &out) const override
+        {
+            Lock lock(mutex);
+            auto *mapped = static_cast<const uint8_t *>(gs.map_vram_read(0, VramSize));
+            ++readbacks;
+            out.assign(mapped, mapped + VramSize);
+        }
+
+        bool ClearFramebuffer(const GSContext &ctx, uint32_t rgba) override
+        {
+            Lock lock(mutex);
+            if (!ctx.frame.fbw || (ctx.frame.psm != GS_PSM_CT32 && ctx.frame.psm != GS_PSM_CT24 &&
+                                   ctx.frame.psm != GS_PSM_CT16 && ctx.frame.psm != GS_PSM_CT16S))
+                return false;
+
+            gs.map_vram_read(0, VramSize); // FBMSK and untouched VRAM require current contents.
+            auto *mapped = static_cast<uint8_t *>(gs.map_vram_write(0, VramSize));
+            ++readbacks;
+            auto access = pixelAccess(ctx.frame.psm);
+
+            if (ctx.fba & 1)
+                rgba |= 0x80000000u;
+            if (bitsPerPixel(ctx.frame.psm) == 16)
+                rgba = ((rgba >> 3) & 31) | ((rgba >> 6) & 0x3e0) | ((rgba >> 9) & 0x7c00) | ((rgba >> 16) & 0x8000);
+
+            for (uint32_t y = ctx.scissor.y0; y <= ctx.scissor.y1; ++y)
+                for (uint32_t x = ctx.scissor.x0; x <= ctx.scissor.x1; ++x)
+                {
+                    auto old = access.read(mapped, ctx.frame.fbp * 32, ctx.frame.fbw, x, y);
+                    access.write(mapped, ctx.frame.fbp * 32, ctx.frame.fbw, x, y,
+                                 (rgba & ~ctx.frame.fbmsk) | (old & ctx.frame.fbmsk));
+                }
+            gs.end_vram_write(0, VramSize);
+            return true;
+        }
+
+        uint32_t ConsumeLocalToHostBytes(uint8_t *dst, uint32_t maxBytes) override
+        {
+            Lock lock(mutex);
+            if (!dst)
+                return 0;
+            auto count = uint32_t(std::min<size_t>(maxBytes, transfer.localToHostPendingBytes));
+            for (uint32_t i = 0; i < count; ++i)
+            {
+                if (fifoOffset == 16)
+                {
+                    gs.read_transfer_fifo(fifoTail.data(), 1);
+                    fifoOffset = 0;
+                }
+                dst[i] = fifoTail[fifoOffset++];
+            }
+            transfer.localToHostPendingBytes -= count;
+            return count;
+        }
+
+        GSTransferSnapshot GetTransferSnapshot() const override
+        {
+            Lock lock(mutex);
+            return transfer;
+        }
+
+        void ReadRegisterState(GSDebugSnapshot &s) const override
+        {
+            Lock lock(mutex);
+            const auto &r = gs.get_register_state();
+            for (unsigned i = 0; i < 2; ++i)
+            {
+                auto &c = s.ctx[i];
+                const auto &v = r.ctx[i];
+                auto f = v.frame.bits, t = v.tex0.bits, sc = v.scissor.bits, z = v.zbuf.bits;
+                c.frame = {uint32_t(f & 511), uint32_t((f >> 16) & 63), uint8_t((f >> 24) & 63), uint32_t(f >> 32)};
+                c.zbuf = {uint32_t(z & 511), uint8_t(((z >> 24) & 15) | 0x30), bool((z >> 32) & 1)};
+                c.scissor = {uint16_t(sc & 2047), uint16_t((sc >> 16) & 2047), uint16_t((sc >> 32) & 2047), uint16_t((sc >> 48) & 2047)};
+                c.xyoffset = {uint16_t(v.xyoffset.bits), uint16_t(v.xyoffset.bits >> 32)};
+                c.tex0 = {uint32_t(t & 16383), uint8_t((t >> 14) & 63), uint8_t((t >> 20) & 63), uint8_t((t >> 26) & 15),
+                          uint8_t((t >> 30) & 15), uint8_t((t >> 34) & 1), uint8_t((t >> 35) & 3), uint32_t((t >> 37) & 16383),
+                          uint8_t((t >> 51) & 15), uint8_t((t >> 55) & 1), uint8_t((t >> 56) & 31), uint8_t(t >> 61)};
+                c.tex1 = v.tex1.bits;
+                c.miptbp1 = v.miptbl_1_3.bits;
+                c.miptbp2 = v.miptbl_4_6.bits;
+                c.clamp = v.clamp.bits;
+                c.alpha = v.alpha.bits;
+                c.test = v.test.bits;
+                c.fba = v.fba.bits;
+            }
+
+            auto p = r.prim.bits;
+            s.prim = {GSPrimType(p & 7), bool(p & 8), bool(p & 16), bool(p & 32), bool(p & 64), bool(p & 128), bool(p & 256), bool(p & 512), bool(p & 1024)};
+            auto b = r.bitbltbuf.bits, t = r.trxpos.bits, a = r.texa.bits, c = r.texclut.bits;
+            s.texa = {uint8_t(a), bool(a & 0x8000), uint8_t(a >> 32)};
+            s.texclut = {uint8_t(c & 63), uint8_t((c >> 6) & 63), uint16_t((c >> 12) & 1023)};
+            s.scanmsk = r.scanmsk.bits;
+            s.dimx = r.dimx.bits;
+            s.dthe = r.dthe.bits;
+            s.colclamp = r.colclamp.bits;
+            s.bitbltbuf = {uint32_t(b & 16383), uint8_t((b >> 16) & 63), uint8_t((b >> 24) & 63),
+                           uint32_t((b >> 32) & 16383), uint8_t((b >> 48) & 63), uint8_t((b >> 56) & 63)};
+
+            s.trxpos = {uint16_t(t & 2047), uint16_t((t >> 16) & 2047), uint16_t((t >> 32) & 2047), uint16_t((t >> 48) & 2047), uint8_t((t >> 59) & 3)};
+            s.trxreg = {uint16_t(r.trxreg.bits & 4095), uint16_t((r.trxreg.bits >> 32) & 4095)};
+            s.trxdir = uint32_t(r.trxdir.bits & 3);
+        }
+    };
+}
+
+std::unique_ptr<GSRasterBackend> CreateParallelGSBackend(GSRegisters &registers)
+{
+    // MKSM: upstream's RUNTIME_WARNING (ps2_log.h on its branch) is not in the pinned tree.
+    std::cerr << "GS Parallel backend is experimental and may not be fully compatible with all games." << std::endl;
+    return std::make_unique<ParallelBackend>(registers);
+}
