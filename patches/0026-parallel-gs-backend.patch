+    // MKSM: the backend's own Vulkan device (Granite picks the GPU). Upstream shares the frames with the window's
+    // OpenGL context (gs_gl_interop.cpp), which crashed AMD's OpenGL driver (atio6axx.dll) here; Present reads them
+    // back to host memory instead, and the host shows them as it shows the CPU backend's.
+    struct VulkanDevice
+    {
+        Vulkan::Context context;
+        Vulkan::Device device;
