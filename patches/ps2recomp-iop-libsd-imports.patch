+
+    // MKSM-Port: LIBSD by import ordinal. Shaolin Monks' sound drivers (CRI ADX, Midway's SNDF) and SDRDRV run from the
+    // disc in the interpreter and call LIBSD.IRX through its exports; its build is not the one the offsets above name,
+    // so its own code ran and wrote SPU2 registers that exist nowhere: no sound at all. LIBSD's export table is the
+    // same in every build, so the emulator hands each "libsd" import here; the ordinals without a handler (Note2Pitch,
+    // ProcBatch, the reverb calls) still run the module's code.
+    bool iopNativeLibsdImport(uint32_t ordinal, IopNativeCall &call)
+    {
+        switch (ordinal)
+        {
+        case 4: sdInit(call); return true;
+        case 5: sdSetParam(call); return true;
+        case 6: sdGetParam(call); return true;
+        case 7: sdSetSwitch(call); return true;
+        case 8: sdGetSwitch(call); return true;
+        case 9: sdSetAddr(call); return true;
+        case 10: sdGetAddr(call); return true;
+        case 11: sdSetCoreAttr(call); return true;
+        case 12: sdGetCoreAttr(call); return true;
+        case 17: sdVoiceTrans(call); return true;
+        case 18: sdBlockTrans(call); return true;
+        case 19: sdVoiceTransStatus(call); return true;
+        case 20: sdBlockTransStatus(call); return true;
+        case 23: sdSetEffectAttr(call); return true;
+        case 26: sdSetTransIntrHandler(call); return true;
+        case 27: sdSetSpu2IntrHandler(call); return true;
+        case 28: sdGetTransIntrHandlerArgument(call); return true;
+        case 30: sdStopTrans(call); return true;
+        case 31: sdSetEffectWorkArea(call); return true;
+        default: return false;
+        }
+    }
+
+    // MKSM-Port: a block transfer in loop mode raises its channel's transfer interrupt each time half of the IOP ring has
+    // been played, and LIBSD calls the handler set with sceSdSetTransIntrHandler (CRI ADX refills that half there).
+    void iopNativeLibsdStreamInterrupts(IopNativeServices &services)
+    {
+        for (uint32_t channel = 0; channel < 2u; ++channel)
+            if (services.sound().takeStreamHalf(channel) && g_libsd.blockActive[channel] && g_libsd.handler[channel] != 0u)
+                services.callGuestLater(g_libsd.handler[channel], g_libsd.handlerGp[channel], channel, g_libsd.handlerArg[channel], 0u);
+    }
 }
