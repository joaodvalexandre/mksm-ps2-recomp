diff --git a/ps2xRuntime/src/lib/Kernel/Stubs/GS.cpp b/ps2xRuntime/src/lib/Kernel/Stubs/GS.cpp
index 55b4fc8..09ffbf4 100644
--- a/ps2xRuntime/src/lib/Kernel/Stubs/GS.cpp
+++ b/ps2xRuntime/src/lib/Kernel/Stubs/GS.cpp
@@ -1002,10 +1002,18 @@ namespace ps2_stubs
             h = 448;
 
         uint32_t fbw = (w + 63) / 64;
-        uint64_t dispfb = makeDispFb(0, fbw, psm, 0, 0);
-        uint64_t display = makeDisplay(dx, dy, 0, 0, w - 1, h - 1);
+        // MKSM-Port: like libgraph, the whole sceGsDispEnv is written, not only DISPFB/DISPLAY: PMODE 0x66 (read
+        // circuit 2, CRTMD 1, MMOD, AMOD), SMODE2 from the sceGsResetGraph mode and BGCOLOR 0. A game that builds its
+        // display with it and applies it with sceGsPutDispEnv (Mortal Kombat: Shaolin Monks) otherwise sent PMODE 0 at
+        // every flip: no read circuit was enabled and the host only showed its blank (magenta) frame.
+        GsDispEnvMem env{};
+        env.pmode = makePmode(0u, 1u, 1u, 1u, 0u, 0u);
+        env.smode2 = (g_gparam.interlace & 1u) == 0u ? 2u : ((g_gparam.ffmode & 1u) != 0u ? 3u : 1u);
+        env.dispfb = makeDispFb(0, fbw, psm, 0, 0);
+        env.display = makeDisplay(dx, dy, 0, 0, w - 1, h - 1);
+        env.bgcolor = 0u;
 
-        writeGsDispEnv(rdram, envAddr, display, dispfb);
+        writeGsDispEnv(rdram, envAddr, env);
         setReturnS32(ctx, 0);
     }
 
