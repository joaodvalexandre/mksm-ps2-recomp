+        // MKSM: the compares in the PS2's number format (hardware rows of ps2autotests, tests/cpu/ee_fpu/compare):
+        // exponent 255 is an ordinary exponent, exponent 0 is zero. Host compares are false for the patterns the host
+        // reads as NaN, such as the 0x7FFFFFFF that 1/0 gives.
+        tc.Run("FPU compares order sign and magnitude, with no NaN and exponent 0 as zero", [](TestCase &t)
+        {
+            const float one = 1.0f;
+            const float huge = floatOf(0x7FFFFFFFu);
+            t.IsTrue(FPU_C_OLT_S(one, floatOf(0x7F7FFFFFu)), "lt 1, max");
+            t.IsTrue(FPU_C_OLT_S(one, huge), "lt 1, 7fffffff");
+            t.IsTrue(FPU_C_EQ_S(huge, huge), "eq 7fffffff, 7fffffff");
+            t.IsTrue(FPU_C_OLE_S(0.0f, huge), "le 0, 7fffffff");
+            t.IsTrue(FPU_C_EQ_S(0.0f, floatOf(0x00000001u)), "eq 0, 00000001");
+            t.IsFalse(FPU_C_OLT_S(0.0f, floatOf(0x00000001u)), "lt 0, 00000001");
+            t.IsTrue(FPU_C_OLT_S(floatOf(0x7F800000u), floatOf(0x7F800001u)), "lt 7f800000, 7f800001");
+            t.IsTrue(FPU_C_EQ_S(0.0f, floatOf(0x80000000u)), "eq +0, -0");
+            t.IsTrue(FPU_C_OLT_S(floatOf(0xFFFFFFFFu), -1.0f), "lt ffffffff, -1");
+            t.IsTrue(FPU_C_OLT_S(-2.0f, -1.0f), "lt -2, -1");
+            t.IsFalse(FPU_C_OLT_S(2.0f, 1.0f), "lt 2, 1");
+            t.IsTrue(FPU_C_OLE_S(1.0f, 1.0f), "le 1, 1");
+            t.IsFalse(FPU_C_EQ_S(1.0f, 2.0f), "eq 1, 2");
+            // the quotient of a division by zero compares as the largest number
+            const float quotient = FPU_DIV_S(one, 0.0f);
+            t.IsTrue(FPU_C_OLT_S(100.0f, quotient), "lt 100, 1/0");
+            t.IsTrue(FPU_C_EQ_S(quotient, quotient), "eq 1/0, 1/0");
+        });
+
+        // MKSM: ABS.S clears the sign bit and leaves the rest of the pattern (hardware row "abs CF_MAX_EXP: 7f800001").
+        tc.Run("ABS.S only clears the sign bit", [](TestCase &t)
+        {
+            t.Equals(bitsOf(FPU_ABS_S(floatOf(0xFF800001u))), 0x7F800001u, "abs ff800001");
+            t.Equals(bitsOf(FPU_ABS_S(floatOf(0x7F800001u))), 0x7F800001u, "abs 7f800001");
+            t.Equals(bitsOf(FPU_ABS_S(floatOf(0xFFBFFFFFu))), 0x7FBFFFFFu, "abs ffbfffff");
+            t.Equals(bitsOf(FPU_ABS_S(-2.5f)), bitsOf(2.5f), "abs -2.5");
+            t.Equals(bitsOf(FPU_ABS_S(floatOf(0x80000000u))), 0x00000000u, "abs -0");
+        });
+
