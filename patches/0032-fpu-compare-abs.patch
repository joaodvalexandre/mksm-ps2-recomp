 #define FPU_CVT_L_S(a) ((int64_t)(float)(a))
+// MKSM: the EE compares in its own number format: sign and magnitude, an exponent of 255 is an ordinary exponent
+// (there is no NaN and no infinity, so nothing is ever unordered) and an exponent of 0 is zero (-0 equals +0). A host
+// compare is false for every pattern the host reads as a NaN, 0x7FFFFFFF among them, which is what x/0 and an
+// overflow give. Checked against the 160 compare rows of ps2autotests (tests/cpu/ee_fpu/compare.expected).
+inline int32_t ps2_fcmp_key(float value)
+{
+    const uint32_t bits = std::bit_cast<uint32_t>(value);
+    const int32_t magnitude = static_cast<int32_t>(bits & 0x7FFFFFFFu);
+    if (magnitude < 0x00800000)
+        return 0;
+    return (bits & 0x80000000u) ? -magnitude : magnitude;
+}
