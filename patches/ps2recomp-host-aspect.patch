diff --git a/ps2xRuntime/include/runtime/gs/gs_host_aspect.h b/ps2xRuntime/include/runtime/gs/gs_host_aspect.h
new file mode 100644
index 0000000..0151eac
--- /dev/null
+++ b/ps2xRuntime/include/runtime/gs/gs_host_aspect.h
@@ -0,0 +1,14 @@
+// MKSM-Port: the aspect the host window shows a PS2 frame at (PS2 frames do not have square pixels).
+#pragma once
+
+#include <cstdio>
+
+// MKSM_ASPECT as "<w>:<h>" (16:9, 21:9...); 4:3, the TV picture Shaolin Monks draws, when unset or not a ratio.
+inline float gsHostDisplayAspect(const char *setting)
+{
+    float w = 0.0f, h = 0.0f;
+    char colon = 0;
+    if (setting != nullptr && std::sscanf(setting, "%f%c%f", &w, &colon, &h) == 3 && colon == ':' && w > 0.0f && h > 0.0f)
+        return w / h;
+    return 4.0f / 3.0f;
+}
