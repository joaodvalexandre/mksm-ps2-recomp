+    // MKSM: sceDmaRecvN(chan, addr, qwc), the normal-mode receive of libdma: MADR = addr, QWC = qwc,
+    // CHCR = STR with MODE = normal and DIR = to memory, as the game's own libdma code does. The source is set up
+    // by the caller beforehand (fromSPR reads from the scratchpad at SADR, written directly to the channel).
+    int32_t submitDmaRecv(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        if (!runtime)
+        {
+            return -1;
+        }
+
+        const uint32_t chanArg = getRegU32(ctx, 4);
+        const uint32_t addrArg = getRegU32(ctx, 5);
+        const uint32_t countArg = getRegU32(ctx, 6);
+        const uint32_t channelBase = resolveDmaChannelBase(rdram, chanArg);
+        if (channelBase == 0)
+        {
+            return -1;
+        }
+
+        PS2Memory &mem = runtime->memory();
+        const uint32_t madr = toDmaPhys(addrArg);
+        const uint32_t qwc = normalizeQwcFromArg(countArg);
+        const uint32_t configuredChcr = mem.readIORegister(channelBase + 0x00u);
+        const uint32_t chcr = (configuredChcr & ~0x0000000Du) | 0x00000100u; // MODE = normal, DIR = 0, STR = 1.
+
+        mem.writeIORegister(channelBase + 0x20u, qwc & 0xFFFFu);
+        mem.writeIORegister(channelBase + 0x10u, madr);
+        mem.writeIORegister(channelBase + 0x00u, chcr);
+        mem.processPendingTransfers();
+
+        const std::vector<uint32_t> completedCauses = mem.consumeCompletedDmacCauses();
+        {
+            std::lock_guard<std::mutex> lock(g_dmaStubMutex);
+            g_dmaPendingPolls[channelBase] = 1;
+        }
+        for (const uint32_t completedCause : completedCauses)
+        {
+            ps2_syscalls::dispatchDmacHandlersForCause(rdram, runtime, completedCause);
+        }
+        return 0;
+    }
