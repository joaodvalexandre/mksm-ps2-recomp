+        // MKSM-Port: VCLIPw sets the clipping flags in the hardware order (VU manual, PCSX2 _vuCLIP): bit 0 = x > +w,
+        // bit 1 = x < -w, then y and z. Shaolin Monks classifies a bounding sphere against the frustum planes with
+        // "andi 0xAAA" (the "< -w" bits of two clips); with the bits swapped every object was behind a plane.
+        tc.Run("VU0 macro VCLIPw sets the clip flags in hardware order", [](TestCase &t) {
+            R5900Decoder decoder;
+            CodeGenerator gen({}, {});
+
+            const Instruction vclipw = decoder.decodeInstruction(0x22C8B4u, 0x4BCD41FFu); // vclipw.xyz $vf8, $vf13w
+            const std::string out = gen.translateInstruction(vclipw);
+            printGeneratedCode("vclipw.xyz $vf8, $vf13w", out);
+            t.IsTrue(out.find("ctx->vu0_vf[8]") != std::string::npos, "VCLIPw must compare Fs (vf8)");
+            t.IsTrue(out.find("ctx->vu0_vf[13]") != std::string::npos, "VCLIPw must clip against Ft (vf13)");
+            t.IsTrue(out.find("((gt_mask & 0x1) << 0) | ((lt_mask & 0x1) << 1)") != std::string::npos,
+                     "bit 0 must be x > +w and bit 1 x < -w");
+            t.IsTrue(out.find("((gt_mask & 0x2) << 1) | ((lt_mask & 0x2) << 2)") != std::string::npos,
+                     "bit 2 must be y > +w and bit 3 y < -w");
+            t.IsTrue(out.find("((gt_mask & 0x4) << 2) | ((lt_mask & 0x4) << 3)") != std::string::npos,
+                     "bit 4 must be z > +w and bit 5 z < -w");
+            t.IsTrue(out.find("(ctx->vu0_clip_flags << 6)") != std::string::npos,
+                     "the previous results must shift up by 6 bits");
+        });
+
