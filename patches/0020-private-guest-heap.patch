+void PS2Runtime::setPrivateGuestHeap(uint32_t guestBase, uint32_t guestLimit)
+{
+    configureGuestHeap(guestBase, guestLimit);
+    std::lock_guard<std::mutex> lock(m_guestHeapMutex);
+    m_guestHeapPrivate = true;
+}
+
+bool PS2Runtime::hasPrivateGuestHeap() const
+{
+    std::lock_guard<std::mutex> lock(m_guestHeapMutex);
+    return m_guestHeapPrivate;
+}
+
+void PS2Runtime::recordGameHeap(uint32_t base, uint32_t limit)
+{
+    (void)base;
+    std::lock_guard<std::mutex> lock(m_guestHeapMutex);
+    m_gameHeapLimit = limit;
+}
+
+uint32_t PS2Runtime::gameHeapLimit() const
+{
+    {
+        std::lock_guard<std::mutex> lock(m_guestHeapMutex);
+        if (m_guestHeapPrivate)
+        {
+            return m_gameHeapLimit;
+        }
+    }
+    return guestHeapLimit();
+}
+
 uint32_t PS2Runtime::guestMalloc(uint32_t size, uint32_t alignment)
 {
     std::lock_guard<std::mutex> lock(m_guestHeapMutex);
