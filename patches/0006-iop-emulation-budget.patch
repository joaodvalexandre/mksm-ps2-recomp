         const uint64_t total = m_impl->eeCycleCarry + eeCycles;
         const uint64_t iopCycles = total / 8u;
         m_impl->eeCycleCarry = total % 8u;
-        if (iopCycles)
+        if (iopCycles == 0u)
+            return;
+        // MKSM: the IOP is emulated on the EE executor thread, in lock step with the EE cycles the generated code
+        // accounts. Small steps run as they come. A large step (the EE clock catching up with the host clock after
+        // an idle wait or a slow guest loop) on a busy IOP would interpret hundreds of thousands of instructions
+        // at once and stall the EE for longer than a frame, so large steps are queued as a bounded debt and run in
+        // chunks while the IOP has used less than a quarter of the host time of the current 10 ms window; beyond
+        // that the IOP falls behind instead of the EE. An idle IOP skips ahead at no cost, so the budget only
+        // matters when IOP code spins.
+        constexpr uint64_t kSmallStep = 256u;
+        constexpr uint64_t kChunk = 2048u;
+        constexpr uint64_t kMaxDebt = 36864ull * 20ull; // 20 ms of IOP time
+        constexpr int64_t kWindowNs = 10000000;         // 10 ms windows
+        constexpr int64_t kBudgetNs = kWindowNs / 4;    // the IOP may use a quarter of each window
+        if (iopCycles < kSmallStep && m_impl->iopCycleDebt == 0u)
+        {
             m_impl->runCycles(iopCycles);
+            return;
+        }
+        m_impl->iopCycleDebt = std::min(m_impl->iopCycleDebt + iopCycles, kMaxDebt);
+        const auto now = std::chrono::steady_clock::now();
+        if (now - m_impl->budgetWindowStart >= std::chrono::nanoseconds(kWindowNs))
+        {
+            m_impl->budgetWindowStart = now;
+            m_impl->budgetSpentNs = 0;
+        }
+        while (m_impl->iopCycleDebt != 0u && m_impl->budgetSpentNs < kBudgetNs)
+        {
+            const uint64_t chunk = std::min(m_impl->iopCycleDebt, kChunk);
+            const auto chunkStart = std::chrono::steady_clock::now();
+            m_impl->runCycles(chunk);
+            m_impl->budgetSpentNs += std::chrono::duration_cast<std::chrono::nanoseconds>(
+                                         std::chrono::steady_clock::now() - chunkStart)
+                                         .count();
+            m_impl->iopCycleDebt -= chunk;
+        }
     }
 
