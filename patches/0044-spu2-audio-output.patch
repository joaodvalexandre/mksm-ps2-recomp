 #include <unordered_map>
 #include <sstream>
 
+#if !defined(PLATFORM_VITA)
+// MKSM: the SPU2's output on the host's audio device, as a 48 kHz stereo stream of raylib's. raylib asks for the
+// samples on its audio thread, and the callback only copies them out of the ring the IOP's SPU2 mixes into
+// (runtime/ps2_spu2_output.h). With PS2X_AUDIO=0 or no audio device there is no stream, and the SPU2 runs on the
+// host clock instead of the device's.
+namespace
+{
+    std::atomic<PS2Spu2Output *> g_spu2StreamSource{nullptr};
+    AudioStream g_spu2Stream{};
+
+    void spu2StreamCallback(void *buffer, unsigned int frames)
+    {
+        if (PS2Spu2Output *source = g_spu2StreamSource.load(std::memory_order_acquire))
+            source->read(static_cast<int16_t *>(buffer), frames);
+        else
+            std::memset(buffer, 0, static_cast<size_t>(frames) * 2u * sizeof(int16_t));
+    }
+
+    void startSpu2Stream(PS2Spu2Output &output)
+    {
+        const char *setting = std::getenv("PS2X_AUDIO");
+        if (setting && setting[0] == '0')
+        {
+            std::cerr << "[audio] SPU2 output off (PS2X_AUDIO=0)" << std::endl;
+            return;
+        }
+        if (!IsAudioDeviceReady())
+        {
+            std::cerr << "[audio] no audio device: the SPU2 runs without an output" << std::endl;
+            return;
+        }
+        if (g_spu2StreamSource.load(std::memory_order_acquire) != nullptr)
+            return;
+        g_spu2Stream = LoadAudioStream(PS2Spu2Output::SampleRate, 16u, 2u);
+        if (!IsAudioStreamValid(g_spu2Stream))
+        {
+            std::cerr << "[audio] the SPU2 output stream could not be created" << std::endl;
+            return;
+        }
+        g_spu2StreamSource.store(&output, std::memory_order_release);
+        SetAudioStreamCallback(g_spu2Stream, spu2StreamCallback);
+        PlayAudioStream(g_spu2Stream);
+        output.setDeviceAttached(true);
+        std::cerr << "[audio] SPU2 output: 48 kHz stereo, " << output.targetFrames() * 1000u / PS2Spu2Output::SampleRate
+                  << " ms buffered (PS2X_AUDIO_LATENCY)" << std::endl;
+    }
+
+    void stopSpu2Stream(PS2Spu2Output &output)
+    {
+        if (g_spu2StreamSource.load(std::memory_order_acquire) != &output)
+            return;
+        output.setDeviceAttached(false);
+        StopAudioStream(g_spu2Stream);
+        UnloadAudioStream(g_spu2Stream); // raylib takes the stream out under its mixing lock: no callback is left
+        g_spu2StreamSource.store(nullptr, std::memory_order_release);
+        g_spu2Stream = AudioStream{};
+    }
+}
+#endif
