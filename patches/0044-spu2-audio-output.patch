diff --git a/ps2xTest/src/ps2_spu2_output_tests.cpp b/ps2xTest/src/ps2_spu2_output_tests.cpp
new file mode 100644
index 0000000..65d4b9f
--- /dev/null
+++ b/ps2xTest/src/ps2_spu2_output_tests.cpp
@@ -0,0 +1,314 @@
+#include "MiniTest.h"
+#include "runtime/ps2_spu2_output.h"
+#include "../../ps2xIOP/tests/iop_compat_test_support.h"
+
+#include <algorithm>
+#include <cstdint>
+#include <vector>
+
+// MKSM: the SPU2's output ring and its pacing (runtime/ps2_spu2_output.h), without a sound device: the tests stand in
+// for the device's thread by calling read(), and for the host clock with a clock of their own.
+namespace
+{
+    int64_t g_now = 0;
+    int64_t testNow() { return g_now; }
+    constexpr int64_t kMs = 1'000'000;
+
+    // Frame n of the test signal: left = n, right = -n (16 bits each).
+    void counting(std::vector<int16_t> &out, uint64_t first, size_t frames)
+    {
+        out.resize(frames * 2u);
+        for (size_t i = 0; i < frames; ++i)
+        {
+            out[i * 2u] = static_cast<int16_t>(first + i);
+            out[i * 2u + 1u] = static_cast<int16_t>(0u - (first + i));
+        }
+    }
+
+    // What the SPU2 does at a service point: mixes what the output is short of.
+    size_t feed(PS2Spu2Output &output, uint64_t &next)
+    {
+        const size_t wanted = output.framesWanted();
+        std::vector<int16_t> frames;
+        counting(frames, next, wanted);
+        output.writeFrames(frames.data(), wanted);
+        next += wanted;
+        return wanted;
+    }
+
+    // True when 'frames' frames of out are the test signal from frame 'first' on.
+    bool isCounting(const std::vector<int16_t> &out, uint64_t first, size_t frames)
+    {
+        for (size_t i = 0; i < frames; ++i)
+        {
+            if (out[i * 2u] != static_cast<int16_t>(first + i) || out[i * 2u + 1u] != static_cast<int16_t>(0u - (first + i)))
+                return false;
+        }
+        return true;
+    }
+}
+
+void register_ps2_spu2_output_tests()
+{
+    MiniTest::Case("PS2Spu2Output", [](TestCase &tc)
+    {
+        tc.Run("the ring's level and size follow the latency", [](TestCase &t)
+        {
+            g_now = 0;
+            PS2Spu2Output output(60u, testNow);
+            t.Equals(output.targetFrames(), 2880u, "60 ms at 48 kHz should be 2880 frames");
+            t.IsTrue(output.capacityFrames() >= 4u * output.targetFrames() &&
+                         (output.capacityFrames() & (output.capacityFrames() - 1u)) == 0u,
+                     "the ring should be a power of two with room above the target level");
+            t.Equals(PS2Spu2Output(1u, testNow).targetFrames(), 480u, "the latency should not go below 10 ms");
+            t.Equals(PS2Spu2Output(5000u, testNow).targetFrames(), 24000u, "the latency should not go above 500 ms");
+            t.Equals(PS2Spu2Output::latencyFromEnvironment(), PS2Spu2Output::DefaultLatencyMs,
+                     "without PS2X_AUDIO_LATENCY the latency should be the default");
+        });
+
+        tc.Run("a device gets the frames in order, across the ring's wrap", [](TestCase &t)
+        {
+            g_now = 0;
+            PS2Spu2Output output(60u, testNow);
+            output.setDeviceAttached(true);
+            uint64_t written = 0, played = 0;
+            std::vector<int16_t> out;
+            bool ordered = true, levelKept = true;
+            // device periods of several sizes; the SPU2 is served after each, as at a service point
+            const size_t periods[] = {480u, 441u, 1024u, 7u, 960u, 128u};
+            (void)feed(output, written);
+            for (uint32_t round = 0; round < 400u; ++round) // about 200,000 frames: the ring wraps many times
+            {
+                const size_t period = periods[round % 6u];
+                out.assign(period * 2u, 0x5555);
+                output.read(out.data(), period);
+                ordered = ordered && isCounting(out, played, period);
+                played += period;
+                g_now += static_cast<int64_t>(period) * 1'000'000'000 / 48000;
+                const size_t wanted = feed(output, written);
+                levelKept = levelKept && wanted == period && output.bufferedFrames() == output.targetFrames();
+            }
+            t.IsTrue(ordered, "the device should read the frames the SPU2 wrote, in order");
+            t.IsTrue(levelKept, "the SPU2 should be asked for exactly what the device took");
+            const PS2Spu2Output::Stats stats = output.stats();
+            t.Equals(stats.framesPlayed, played, "every frame read should be counted as played");
+            t.Equals(stats.framesMixed, played + output.targetFrames(), "the SPU2 should be one target level ahead");
+            t.IsTrue(stats.gaps == 0u && stats.framesMissing == 0u && stats.framesOverflowed == 0u &&
+                         stats.framesDiscarded == 0u && !stats.clockDriven,
+                     "a device that keeps reading should see no gap, and the host clock should stay out");
+        });
+
+        tc.Run("with no device the host clock takes 48,000 frames a second", [](TestCase &t)
+        {
+            g_now = 5 * kMs;
+            PS2Spu2Output output(60u, testNow);
+            uint64_t written = 0;
+            t.Equals(feed(output, written), static_cast<size_t>(2880u), "an empty ring should want its target level");
+            t.Equals(feed(output, written), static_cast<size_t>(0u), "a ring at its level should want nothing");
+            // service points at uneven distances, ten seconds in all
+            const int64_t steps[] = {1 * kMs, 3 * kMs, 16 * kMs, 250'000, 7 * kMs, 2'750'000};
+            bool neverAbove = true;
+            for (int64_t elapsed = 0, i = 0; elapsed < 10'000 * kMs; ++i)
+            {
+                const int64_t step = std::min<int64_t>(steps[i % 6], 10'000 * kMs - elapsed);
+                g_now += step;
+                elapsed += step;
+                (void)feed(output, written);
+                neverAbove = neverAbove && output.bufferedFrames() == output.targetFrames();
+            }
+            t.Equals(written, static_cast<uint64_t>(2880u + 480000u),
+                     "ten seconds of host time should be exactly 480,000 frames");
+            t.IsTrue(neverAbove, "the ring should be back at its level after each service point");
+            const PS2Spu2Output::Stats stats = output.stats();
+            t.IsTrue(stats.clockDriven && stats.framesDiscarded == 480000u && stats.framesPlayed == 0u && stats.gaps == 0u,
+                     "the frames should be taken by the host clock, none played");
+        });
+
+        tc.Run("a pause of the IOP thread is a gap, not a burst", [](TestCase &t)
+        {
+            // no device: two seconds without a service point
+            g_now = 0;
+            PS2Spu2Output clocked(60u, testNow);
+            uint64_t written = 0;
+            (void)feed(clocked, written);
+            g_now += 2000 * kMs;
+            t.Equals(feed(clocked, written), static_cast<size_t>(2880u),
+                     "after a pause the SPU2 should refill the ring, not make up two seconds");
+
+            // a device: it reads through the pause
+            g_now = 0;
+            PS2Spu2Output output(60u, testNow);
+            output.setDeviceAttached(true);
+            written = 0;
+            (void)feed(output, written);
+            std::vector<int16_t> out(480u * 2u);
+            uint64_t played = 0;
+            bool ordered = true;
+            for (uint32_t period = 0; period < 20u; ++period) // 200 ms with no service point: the ring holds 60
+            {
+                output.read(out.data(), 480u);
+                if (period < 6u)
+                    ordered = ordered && isCounting(out, played, 480u);
+                else if (period > 6u)
+                    ordered = ordered && std::all_of(out.begin(), out.end(), [](int16_t sample) { return sample == 0; });
+                played += period < 6u ? 480u : 0u;
+                g_now += 10 * kMs;
+            }
+            t.IsTrue(ordered, "the device should get the ring's frames, then silence");
+            PS2Spu2Output::Stats stats = output.stats();
+            t.IsTrue(stats.gaps == 1u && stats.framesMissing == 14u * 480u && stats.framesPlayed == 2880u,
+                     "the pause should be counted as one gap of fourteen periods");
+            // the IOP thread is back: the sound goes on with the frame after the last one played
+            t.Equals(feed(output, written), static_cast<size_t>(2880u), "the SPU2 should refill the ring after the pause");
+            out.assign(480u * 2u, 0);
+            output.read(out.data(), 480u);
+            bool resumes = true;
+            for (size_t i = PS2Spu2Output::FadeFrames; i < 480u; ++i)
+                resumes = resumes && out[i * 2u] == static_cast<int16_t>(2880u + i);
+            t.IsTrue(resumes, "no frame should be lost or played twice around a gap");
+            stats = output.stats();
+            t.IsTrue(stats.gaps == 1u && !stats.clockDriven, "the device should still be the one that drains the ring");
+        });
+
+        tc.Run("a gap is entered and left with a ramp", [](TestCase &t)
+        {
+            g_now = 0;
+            PS2Spu2Output output(60u, testNow);
+            output.setDeviceAttached(true);
+            std::vector<int16_t> level(400u * 2u);
+            for (size_t i = 0; i < 400u; ++i)
+            {
+                level[i * 2u] = 16000;
+                level[i * 2u + 1u] = -16000;
+            }
+            output.writeFrames(level.data(), 100u);
+            std::vector<int16_t> out(300u * 2u, 0x5555);
+            output.read(out.data(), 300u);
+            bool steady = true, down = true, silent = true;
+            for (size_t i = 0; i < 100u; ++i)
+                steady = steady && out[i * 2u] == 16000 && out[i * 2u + 1u] == -16000;
+            for (size_t i = 100u; i < 100u + PS2Spu2Output::FadeFrames; ++i)
+                down = down && out[i * 2u] < out[(i - 1u) * 2u] && out[i * 2u] >= 0 && out[i * 2u + 1u] == -out[i * 2u];
+            for (size_t i = 100u + PS2Spu2Output::FadeFrames; i < 300u; ++i)
+                silent = silent && out[i * 2u] == 0 && out[i * 2u + 1u] == 0;
+            t.IsTrue(steady, "the frames before the gap should be untouched");
+            t.IsTrue(down && out[(100u + PS2Spu2Output::FadeFrames - 1u) * 2u] == 0,
+                     "the last sample should go down to silence step by step");
+            t.IsTrue(silent, "the rest of the gap should be silence");
+
+            output.writeFrames(level.data(), 400u);
+            out.assign(400u * 2u, 0x5555);
+            output.read(out.data(), 400u);
+            bool up = out[0] > 0 && out[0] < 1000, after = true;
+            for (size_t i = 1; i < PS2Spu2Output::FadeFrames; ++i)
+                up = up && out[i * 2u] > out[(i - 1u) * 2u] && out[i * 2u + 1u] == -out[i * 2u];
+            for (size_t i = PS2Spu2Output::FadeFrames; i < 400u; ++i)
+                after = after && out[i * 2u] == 16000 && out[i * 2u + 1u] == -16000;
+            t.IsTrue(up, "the sound should come back up from silence step by step");
+            t.IsTrue(after, "the frames after the ramp should be untouched");
+            t.Equals(output.stats().gaps, static_cast<uint64_t>(1u), "one gap should be counted");
+        });
+
+        tc.Run("a device that stops reading hands the ring to the host clock", [](TestCase &t)
+        {
+            g_now = 0;
+            PS2Spu2Output output(60u, testNow);
+            output.setDeviceAttached(true);
+            uint64_t written = 0;
+            // attached, but its first callback has not come: the clock drains the ring meanwhile
+            (void)feed(output, written);
+            g_now += 100 * kMs;
+            t.Equals(feed(output, written), static_cast<size_t>(2880u),
+                     "before the device's first read the host clock should drain the ring");
+            t.IsTrue(output.stats().clockDriven, "the host clock should be draining the ring");
+
+            // the device reads: it takes over
+            std::vector<int16_t> out(480u * 2u);
+            output.read(out.data(), 480u);
+            g_now += 10 * kMs;
+            t.Equals(feed(output, written), static_cast<size_t>(480u), "the device's period should be what the SPU2 makes");
+            t.IsFalse(output.stats().clockDriven, "a reading device should be the one that drains the ring");
+            const uint64_t discarded = output.stats().framesDiscarded;
+
+            // it stops (unplugged, or its thread is held up): after a quarter of a second the clock is back
+            g_now += 200 * kMs;
+            t.Equals(feed(output, written), static_cast<size_t>(0u), "a short silence of the device should change nothing");
+            g_now += 100 * kMs;
+            t.Equals(feed(output, written), static_cast<size_t>(0u), "the clock should start from the moment it takes over");
+            g_now += 20 * kMs;
+            t.Equals(feed(output, written), static_cast<size_t>(960u), "then the host clock should take 48 frames a millisecond");
+            t.IsTrue(output.stats().clockDriven && output.stats().framesDiscarded == discarded + 960u,
+                     "the frames should be counted as taken by the host clock");
+
+            // it comes back and gets the newest frames, not a quarter of a second of old ones
+            out.assign(480u * 2u, 0);
+            output.read(out.data(), 480u);
+            t.IsTrue(out[0] == static_cast<int16_t>(written - 2880u),
+                     "the device should go on with what the ring holds now");
+            output.setDeviceAttached(false);
+            g_now += 10 * kMs;
+            (void)feed(output, written);
+            t.IsTrue(output.stats().clockDriven, "a detached device should leave the ring to the host clock at once");
+        });
+
+        tc.Run("frames written beyond the ring's size are dropped", [](TestCase &t)
+        {
+            g_now = 0;
+            PS2Spu2Output output(60u, testNow);
+            output.setDeviceAttached(true);
+            const size_t capacity = output.capacityFrames();
+            std::vector<int16_t> frames;
+            counting(frames, 0u, capacity + 100u);
+            output.writeFrames(frames.data(), capacity + 100u);
+            t.Equals(output.bufferedFrames(), capacity, "the ring should be full");
+            t.Equals(output.stats().framesOverflowed, static_cast<uint64_t>(100u), "the frames that did not fit should be counted");
+            std::vector<int16_t> out(capacity * 2u);
+            output.read(out.data(), capacity);
+            t.IsTrue(isCounting(out, 0u, capacity), "the frames that were in the ring should not be overwritten");
+            t.Equals(output.framesWanted(), static_cast<size_t>(output.targetFrames()), "an emptied ring should want its level");
+        });
+
+        // The whole path with the IOP: a sound unit with nothing to play still advances with the host clock, exactly.
+        tc.Run("the IOP's SPU2 follows the output: 48,000 frames for a second of host time", [](TestCase &t)
+        {
+            g_now = 0;
+            PS2Spu2Output output(60u, testNow);
+            iop_test::Host host;
+            ps2x::iop::IopSubsystem subsystem(host);
+            subsystem.setSoundSink(&output);
+            subsystem.runEeCycles(255u * 8u); // the first service point: the ring is filled, the clock starts
+            t.Equals(iop_test::metric(subsystem, "spu2", "frames"), static_cast<uint64_t>(2880u),
+                     "the SPU2 should fill the ring at the first service point");
+            // A second of host time in 1 ms steps. The EE hands the IOP a ninth of the cycles of a real second (in
+            // steps small enough to run at once, whatever the emulation budget), then twice a real second's in the
+            // next one: the SPU2 does not care.
+            for (uint32_t ms = 0; ms < 1000u; ++ms)
+            {
+                g_now += kMs;
+                for (uint32_t step = 0; step < 16u; ++step)
+                    subsystem.runEeCycles(255u * 8u);
+            }
+            t.Equals(iop_test::metric(subsystem, "spu2", "frames"), static_cast<uint64_t>(2880u + 48000u),
+                     "a slow IOP clock should not slow the sound unit down");
+            for (uint32_t ms = 0; ms < 1000u; ++ms)
+            {
+                g_now += kMs;
+                for (uint32_t step = 0; step < 290u; ++step)
+                    subsystem.runEeCycles(255u * 8u);
+            }
+            t.Equals(iop_test::metric(subsystem, "spu2", "frames"), static_cast<uint64_t>(2880u + 96000u),
+                     "a fast IOP clock should not speed the sound unit up");
+            t.Equals(output.stats().framesMixed, static_cast<uint64_t>(2880u + 96000u),
+                     "every frame the SPU2 made should be in the output");
+            // without an output the SPU2 is clocked by IOP cycles again, 768 a frame from here on (it makes its
+            // frames in batches of 128 while nothing is due)
+            subsystem.setSoundSink(nullptr);
+            const uint64_t before = iop_test::metric(subsystem, "spu2", "frames");
+            for (uint32_t step = 0; step < 1506u; ++step) // 500 frames of IOP time
+                subsystem.runEeCycles(255u * 8u);
+            const uint64_t made = iop_test::metric(subsystem, "spu2", "frames") - before;
+            t.IsTrue(made > 500u - 130u && made <= 500u,
+                     "without an output the SPU2 should follow the IOP's cycles from the moment the output left");
+        });
+    });
+}
