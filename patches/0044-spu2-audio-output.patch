@@ -0,0 +1,125 @@
+#ifndef PS2_SPU2_OUTPUT_H
+#define PS2_SPU2_OUTPUT_H
+
+// MKSM: the SPU2's way out to the host's audio device.
+//
+// The IOP's SPU2 (ps2xIOP) mixes on the thread that runs the IOP; an audio device asks for samples on a thread of its
+// own. Between the two sits a ring of stereo frames with one writer and one reader and no lock: the device's callback
+// only copies frames out (read), the IOP thread only puts frames in (writeFrames).
+//
+// This object is also the SPU2's clock (ps2x::iop::IopSoundSink): the SPU2 mixes what framesWanted() returns, which is
+// what the ring is short of its target level. So the sound unit advances exactly as fast as the device plays, 48,000
+// frames for each second of the device's clock: the ring neither runs dry nor fills up over time, and nothing has to
+// be resampled or dropped to keep the two in step. The emulated IOP's own clock (cycles handed out by the EE, in
+// bursts, some of them lost when the IOP is busy) is not in the path.
+//
+// While no device reads (none exists, PS2X_AUDIO=0, or the device stopped asking), the host's clock drains the ring
+// at 48,000 frames a second, so the sound drivers see the same sound unit with or without a device.
+//
+// When the IOP thread is away for longer than the ring covers (the target level, PS2X_AUDIO_LATENCY milliseconds, 60
+// by default), the device gets silence, entered and left with a short ramp. The frames of that gap are not made up
+// afterwards: the sound unit stood still and goes on where it was.
+//
+// Diagnostics: MKSM_TRACE_AUDIO=1 logs a [mksm-audio] line every five seconds (frames mixed and played, gaps, the
+// ring's level); MKSM_AUDIO_WAV=<file> records what the SPU2 mixed (the gaps' silence is not in it).
+
+#include "ps2x/iop/iop_sound_sink.h"
+
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <cstdio>
+#include <vector>
+
+class PS2Spu2Output final : public ps2x::iop::IopSoundSink
+{
+public:
+    static constexpr uint32_t SampleRate = 48000u;
+    static constexpr uint32_t DefaultLatencyMs = 60u;
+    static constexpr uint32_t FadeFrames = 64u;                 // the ramp into and out of a gap
+    static constexpr int64_t DeviceStallNs = 250'000'000;       // a device that has not read for this long is gone
+    using NowFunction = int64_t (*)();                          // nanoseconds of a monotonic clock
+
+    // latencyMs: the level the ring is kept at (10..500). now: the clock, the host's steady clock when null.
+    explicit PS2Spu2Output(uint32_t latencyMs = DefaultLatencyMs, NowFunction now = nullptr);
+    ~PS2Spu2Output() override;
+
+    PS2Spu2Output(const PS2Spu2Output &) = delete;
+    PS2Spu2Output &operator=(const PS2Spu2Output &) = delete;
+
+    // PS2X_AUDIO_LATENCY in milliseconds, DefaultLatencyMs when it is not set or not a number
+    [[nodiscard]] static uint32_t latencyFromEnvironment();
+
+    // ---- the thread that runs the IOP (ps2x::iop::IopSoundSink)
+    size_t framesWanted() noexcept override;
+    void writeFrames(const int16_t *stereo, size_t frames) noexcept override;
+
+    // ---- the audio device's thread: 'frames' interleaved signed 16-bit stereo frames at 48 kHz, always all of them
+    void read(int16_t *stereo, size_t frames) noexcept;
+
+    // A device reads the ring (after it was started) or no longer does (before it is stopped).
+    void setDeviceAttached(bool attached) noexcept;
+
+    [[nodiscard]] uint32_t targetFrames() const noexcept { return m_target; }
+    [[nodiscard]] uint32_t capacityFrames() const noexcept { return m_capacity; }
+    [[nodiscard]] size_t bufferedFrames() const noexcept;
+
+    struct Stats
+    {
+        uint64_t framesMixed = 0;     // frames the SPU2 wrote
+        uint64_t framesPlayed = 0;    // frames a device took out of the ring
+        uint64_t framesDiscarded = 0; // frames the host clock took out of the ring (no device)
+        uint64_t framesMissing = 0;   // frames of silence a device got because the ring was empty
+        uint64_t gaps = 0;            // times the ring ran dry under a device
+        uint64_t framesOverflowed = 0; // frames written beyond the ring's capacity (lost)
+        bool clockDriven = true;      // the host clock drains the ring (no device is reading)
+    };
+    [[nodiscard]] Stats stats() const noexcept;
+
+private:
+    [[nodiscard]] uint64_t readPosition() const noexcept;
+    void traceLine(int64_t now, uint64_t level) noexcept;
+    void recordFrames(const int16_t *stereo, size_t frames) noexcept;
+    void writeWavHeader() noexcept;
+
+    NowFunction m_now;
+    uint32_t m_target = 0;   // frames
+    uint32_t m_capacity = 0; // frames, a power of two
+    std::vector<int16_t> m_ring;
+
+    // Frame counts since the start. m_written belongs to the IOP thread, m_read to the device's thread; m_discardTo
+    // is the IOP thread's way to take frames out when no device does: the reader skips to it.
+    std::atomic<uint64_t> m_written{0};
+    std::atomic<uint64_t> m_read{0};
+    std::atomic<uint64_t> m_discardTo{0};
+    std::atomic<int64_t> m_lastReadNs{0};
+    std::atomic<bool> m_deviceAttached{false};
+
+    // the IOP thread
+    bool m_clockDriven = false;
+    int64_t m_clockStartNs = 0;
+    uint64_t m_clockFrames = 0; // frames the host clock has taken since m_clockStartNs
+    std::atomic<bool> m_clockDrivenFlag{true};
+    std::atomic<uint64_t> m_framesDiscarded{0};
+    std::atomic<uint64_t> m_framesOverflowed{0};
+
+    // the device's thread
+    int16_t m_lastOut[2]{};
+    uint32_t m_fadeIn = 0; // frames of the ramp out of a gap still to do
+    bool m_inGap = false;
+    std::atomic<uint64_t> m_framesPlayed{0};
+    std::atomic<uint64_t> m_framesMissing{0};
+    std::atomic<uint64_t> m_gaps{0};
+
+    // diagnostics (the IOP thread)
+    bool m_trace = false;
+    int64_t m_traceNextNs = 0;
+    uint64_t m_traceLow = UINT64_MAX;
+    uint64_t m_traceHigh = 0;
+    Stats m_traceLast{};
+    std::FILE *m_wav = nullptr;
+    uint64_t m_wavFrames = 0;
+    uint64_t m_wavHeaderFrames = 0;
+};
+
+#endif
diff --git a/ps2xRuntime/src/lib/ps2_runtime.cpp b/ps2xRuntime/src/lib/ps2_runtime.cpp
