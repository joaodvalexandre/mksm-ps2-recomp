diff --git a/ps2xRuntime/src/lib/ps2_spu2_output.cpp b/ps2xRuntime/src/lib/ps2_spu2_output.cpp
new file mode 100644
index 0000000..b4ce858
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_spu2_output.cpp
@@ -0,0 +1,294 @@
+#include "runtime/ps2_spu2_output.h"
+
+#include <algorithm>
+#include <chrono>
+#include <cstdlib>
+#include <cstring>
+#include <limits>
+
+// MKSM: the SPU2's output ring and pacing (see runtime/ps2_spu2_output.h).
+namespace
+{
+    constexpr int64_t kNever = std::numeric_limits<int64_t>::min();
+    constexpr int64_t kSecondNs = 1'000'000'000;
+    constexpr int64_t kTraceEveryNs = 5 * kSecondNs;
+
+    int64_t steadyNow()
+    {
+        return std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch()).count();
+    }
+
+    void put16(uint8_t *bytes, uint32_t value)
+    {
+        bytes[0] = static_cast<uint8_t>(value);
+        bytes[1] = static_cast<uint8_t>(value >> 8u);
+    }
+
+    void put32(uint8_t *bytes, uint32_t value)
+    {
+        put16(bytes, value);
+        put16(bytes + 2, value >> 16u);
+    }
+}
+
+PS2Spu2Output::PS2Spu2Output(uint32_t latencyMs, NowFunction now)
+    : m_now(now ? now : steadyNow)
+{
+    m_target = std::clamp<uint32_t>(latencyMs, 10u, 500u) * SampleRate / 1000u;
+    m_capacity = 8192u;
+    while (m_capacity < m_target * 4u)
+        m_capacity *= 2u;
+    m_ring.assign(static_cast<size_t>(m_capacity) * 2u, int16_t{0});
+    m_lastReadNs.store(kNever, std::memory_order_relaxed);
+
+    const char *trace = std::getenv("MKSM_TRACE_AUDIO");
+    m_trace = trace && *trace && *trace != '0';
+    const char *wav = std::getenv("MKSM_AUDIO_WAV");
+    if (wav && *wav)
+    {
+        m_wav = std::fopen(wav, "wb");
+        if (m_wav)
+            writeWavHeader();
+        else
+            std::fprintf(stderr, "[mksm-audio] MKSM_AUDIO_WAV: cannot write %s\n", wav);
+    }
+}
+
+PS2Spu2Output::~PS2Spu2Output()
+{
+    if (m_wav)
+    {
+        writeWavHeader();
+        std::fclose(m_wav);
+    }
+}
+
+uint32_t PS2Spu2Output::latencyFromEnvironment()
+{
+    const char *setting = std::getenv("PS2X_AUDIO_LATENCY");
+    if (!setting || !*setting)
+        return DefaultLatencyMs;
+    char *end = nullptr;
+    const long value = std::strtol(setting, &end, 10);
+    return end != setting && value > 0 ? static_cast<uint32_t>(std::min<long>(value, 500)) : DefaultLatencyMs;
+}
+
+// The reader's position as the writer sees it: what the device has read, or what the host clock took.
+uint64_t PS2Spu2Output::readPosition() const noexcept
+{
+    return std::max(m_read.load(std::memory_order_acquire), m_discardTo.load(std::memory_order_relaxed));
+}
+
+size_t PS2Spu2Output::bufferedFrames() const noexcept
+{
+    const uint64_t written = m_written.load(std::memory_order_acquire);
+    const uint64_t read = readPosition();
+    return written > read ? static_cast<size_t>(written - read) : 0u;
+}
+
+void PS2Spu2Output::setDeviceAttached(bool attached) noexcept
+{
+    if (!attached)
+        m_lastReadNs.store(kNever, std::memory_order_relaxed);
+    m_deviceAttached.store(attached, std::memory_order_release);
+}
+
+size_t PS2Spu2Output::framesWanted() noexcept
+{
+    const int64_t now = m_now();
+    const uint64_t written = m_written.load(std::memory_order_relaxed);
+    uint64_t read = readPosition();
+    uint64_t level = written - read;
+
+    // Who takes frames out of the ring: the device, while it keeps asking; otherwise the host clock.
+    const int64_t lastRead = m_lastReadNs.load(std::memory_order_relaxed);
+    const bool device = m_deviceAttached.load(std::memory_order_acquire) && lastRead != kNever &&
+                        now - lastRead < DeviceStallNs;
+    if (device)
+    {
+        m_clockDriven = false;
+    }
+    else
+    {
+        if (!m_clockDriven)
+        {
+            m_clockDriven = true;
+            m_clockStartNs = now;
+            m_clockFrames = 0;
+        }
+        if (now - m_clockStartNs >= 1000 * kSecondNs) // keeps the product below small
+        {
+            m_clockStartNs += 1000 * kSecondNs;
+            m_clockFrames -= std::min<uint64_t>(m_clockFrames, 1000ull * SampleRate);
+        }
+        const uint64_t due = now > m_clockStartNs
+                                 ? static_cast<uint64_t>(now - m_clockStartNs) * SampleRate / static_cast<uint64_t>(kSecondNs)
+                                 : 0u;
+        if (due > m_clockFrames)
+        {
+            // the frames the clock asks for beyond what the ring holds are a gap: the sound unit stood still
+            const uint64_t taken = std::min(due - m_clockFrames, level);
+            m_clockFrames = due;
+            if (taken != 0u)
+            {
+                read += taken;
+                level -= taken;
+                m_discardTo.store(read, std::memory_order_release);
+                m_framesDiscarded.fetch_add(taken, std::memory_order_relaxed);
+            }
+        }
+    }
+    m_clockDrivenFlag.store(m_clockDriven, std::memory_order_relaxed);
+
+    if (m_trace)
+        traceLine(now, level);
+    return level < m_target ? static_cast<size_t>(m_target - level) : 0u;
+}
+
+void PS2Spu2Output::writeFrames(const int16_t *stereo, size_t frames) noexcept
+{
+    if (!stereo || frames == 0u)
+        return;
+    if (m_wav)
+        recordFrames(stereo, frames);
+    const uint64_t written = m_written.load(std::memory_order_relaxed);
+    const uint64_t level = written - readPosition();
+    const size_t space = level < m_capacity ? static_cast<size_t>(m_capacity - level) : 0u;
+    const size_t count = std::min(frames, space);
+    if (count != frames)
+        m_framesOverflowed.fetch_add(frames - count, std::memory_order_relaxed);
+    const size_t start = static_cast<size_t>(written & (m_capacity - 1u));
+    const size_t first = std::min<size_t>(count, m_capacity - start);
+    std::memcpy(m_ring.data() + start * 2u, stereo, first * 2u * sizeof(int16_t));
+    std::memcpy(m_ring.data(), stereo + first * 2u, (count - first) * 2u * sizeof(int16_t));
+    m_written.store(written + count, std::memory_order_release);
+}
+
+void PS2Spu2Output::read(int16_t *stereo, size_t frames) noexcept
+{
+    if (!stereo || frames == 0u)
+        return;
+    uint64_t read = std::max(m_read.load(std::memory_order_relaxed), m_discardTo.load(std::memory_order_acquire));
+    const uint64_t written = m_written.load(std::memory_order_acquire);
+    const size_t available = written > read ? static_cast<size_t>(written - read) : 0u;
+    const size_t count = std::min(frames, available);
+
+    const size_t start = static_cast<size_t>(read & (m_capacity - 1u));
+    const size_t first = std::min<size_t>(count, m_capacity - start);
+    std::memcpy(stereo, m_ring.data() + start * 2u, first * 2u * sizeof(int16_t));
+    std::memcpy(stereo + first * 2u, m_ring.data(), (count - first) * 2u * sizeof(int16_t));
+
+    // out of a gap: the first frames come up from silence
+    for (size_t frame = 0; frame < count && m_fadeIn != 0u; ++frame, --m_fadeIn)
+    {
+        const int32_t gain = static_cast<int32_t>(FadeFrames - m_fadeIn + 1u);
+        stereo[frame * 2u] = static_cast<int16_t>(stereo[frame * 2u] * gain / static_cast<int32_t>(FadeFrames));
+        stereo[frame * 2u + 1u] = static_cast<int16_t>(stereo[frame * 2u + 1u] * gain / static_cast<int32_t>(FadeFrames));
+    }
+
+    if (count < frames)
+    {
+        // The ring is empty: the last sample goes down to silence over a few frames instead of in one step.
+        const int32_t last[2] = {count != 0u ? stereo[(count - 1u) * 2u] : m_lastOut[0],
+                                 count != 0u ? stereo[(count - 1u) * 2u + 1u] : m_lastOut[1]};
+        const size_t ramp = std::min<size_t>(frames - count, FadeFrames);
+        for (size_t frame = 0; frame < ramp; ++frame)
+        {
+            const int32_t gain = static_cast<int32_t>(FadeFrames - 1u - frame);
+            stereo[(count + frame) * 2u] = static_cast<int16_t>(last[0] * gain / static_cast<int32_t>(FadeFrames));
+            stereo[(count + frame) * 2u + 1u] = static_cast<int16_t>(last[1] * gain / static_cast<int32_t>(FadeFrames));
+        }
+        std::memset(stereo + (count + ramp) * 2u, 0, (frames - count - ramp) * 2u * sizeof(int16_t));
+        m_fadeIn = FadeFrames;
+        if (written != 0u) // before the SPU2's first frame there is nothing to miss
+        {
+            m_framesMissing.fetch_add(frames - count, std::memory_order_relaxed);
+            if (!m_inGap)
+                m_gaps.fetch_add(1u, std::memory_order_relaxed);
+            m_inGap = true;
+        }
+    }
+    else
+    {
+        m_inGap = false;
+    }
+    m_lastOut[0] = stereo[(frames - 1u) * 2u];
+    m_lastOut[1] = stereo[(frames - 1u) * 2u + 1u];
+
+    m_read.store(read + count, std::memory_order_release);
+    m_framesPlayed.fetch_add(count, std::memory_order_relaxed);
+    m_lastReadNs.store(m_now(), std::memory_order_relaxed);
+}
+
+PS2Spu2Output::Stats PS2Spu2Output::stats() const noexcept
+{
+    Stats stats;
+    stats.framesPlayed = m_framesPlayed.load(std::memory_order_relaxed);
+    stats.framesDiscarded = m_framesDiscarded.load(std::memory_order_relaxed);
+    stats.framesMissing = m_framesMissing.load(std::memory_order_relaxed);
+    stats.gaps = m_gaps.load(std::memory_order_relaxed);
+    stats.framesOverflowed = m_framesOverflowed.load(std::memory_order_relaxed);
+    stats.framesMixed = m_written.load(std::memory_order_relaxed) + stats.framesOverflowed;
+    stats.clockDriven = m_clockDrivenFlag.load(std::memory_order_relaxed);
+    return stats;
+}
+
+// MKSM_TRACE_AUDIO=1: every five seconds, what was mixed, played and missed since the last line, and the lowest and
+// highest level of the ring at the moments the SPU2 asked.
+void PS2Spu2Output::traceLine(int64_t now, uint64_t level) noexcept
+{
+    m_traceLow = std::min(m_traceLow, level);
+    m_traceHigh = std::max(m_traceHigh, level);
+    if (m_traceNextNs == 0)
+        m_traceNextNs = now + kTraceEveryNs;
+    if (now < m_traceNextNs)
+        return;
+    const Stats current = stats();
+    std::fprintf(stderr,
+                 "[mksm-audio] mixed=%llu played=%llu discarded=%llu missing=%llu gaps=%llu overflowed=%llu "
+                 "level=%llu-%llu of %u frames, drained by the %s\n",
+                 static_cast<unsigned long long>(current.framesMixed - m_traceLast.framesMixed),
+                 static_cast<unsigned long long>(current.framesPlayed - m_traceLast.framesPlayed),
+                 static_cast<unsigned long long>(current.framesDiscarded - m_traceLast.framesDiscarded),
+                 static_cast<unsigned long long>(current.framesMissing - m_traceLast.framesMissing),
+                 static_cast<unsigned long long>(current.gaps - m_traceLast.gaps),
+                 static_cast<unsigned long long>(current.framesOverflowed - m_traceLast.framesOverflowed),
+                 static_cast<unsigned long long>(m_traceLow), static_cast<unsigned long long>(m_traceHigh), m_target,
+                 current.clockDriven ? "host clock" : "device");
+    m_traceLast = current;
+    m_traceLow = UINT64_MAX;
+    m_traceHigh = 0;
+    m_traceNextNs = now + kTraceEveryNs;
+}
+
+// MKSM_AUDIO_WAV=<file>: the frames as the SPU2 made them. The header is brought up to date once a second of sound,
+// so the file is whole when the process is ended from outside.
+void PS2Spu2Output::recordFrames(const int16_t *stereo, size_t frames) noexcept
+{
+    m_wavFrames += std::fwrite(stereo, 2u * sizeof(int16_t), frames, m_wav);
+    if (m_wavFrames - m_wavHeaderFrames >= SampleRate)
+        writeWavHeader();
+}
+
+void PS2Spu2Output::writeWavHeader() noexcept
+{
+    const uint32_t dataBytes = static_cast<uint32_t>(std::min<uint64_t>(m_wavFrames * 4u, 0xFFFFFF00u));
+    uint8_t header[44];
+    std::memcpy(header, "RIFF", 4);
+    put32(header + 4, 36u + dataBytes);
+    std::memcpy(header + 8, "WAVEfmt ", 8);
+    put32(header + 16, 16u);            // the format chunk
+    put16(header + 20, 1u);             // PCM
+    put16(header + 22, 2u);             // stereo
+    put32(header + 24, SampleRate);
+    put32(header + 28, SampleRate * 4u); // bytes a second
+    put16(header + 32, 4u);             // bytes a frame
+    put16(header + 34, 16u);            // bits a sample
+    std::memcpy(header + 36, "data", 4);
+    put32(header + 40, dataBytes);
+    if (std::fseek(m_wav, 0, SEEK_SET) == 0)
+        (void)std::fwrite(header, 1u, sizeof(header), m_wav);
+    (void)std::fseek(m_wav, 0, SEEK_END);
+    (void)std::fflush(m_wav);
+    m_wavHeaderFrames = m_wavFrames;
+}
