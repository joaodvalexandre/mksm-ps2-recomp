diff --git a/ps2xTest/src/ps2_iop_tests.cpp b/ps2xTest/src/ps2_iop_tests.cpp
index f59340d..8228e98 100644
--- a/ps2xTest/src/ps2_iop_tests.cpp
+++ b/ps2xTest/src/ps2_iop_tests.cpp
@@ -95,5 +95,85 @@ void register_ps2_iop_tests()
             t.Equals(loaded.startResult, 0x1234, "sceSdGetParam should return what sceSdSetParam stored");
         });
 
+        // MKSM: the IOP kernel's modload starts a module with (argc, argv): argv[0] is the name the module was started
+        // under, the others point at the NUL-terminated strings of the argument block, and argv[argc] is null. CRI's
+        // ADX driver reads "sdinit=0" and "spucore=2" that way; started with the byte count and the block itself
+        // (upstream) it kept its defaults and reset the sound unit the game had already set up.
+        tc.Run("a module's start function receives argc and argv", [](TestCase &t)
+        {
+            // The start function stores argc at 0x10200, argv[0..argc-1] from 0x10204, argv[argc] at 0x1021C and up to
+            // 32 bytes of each string from 0x10220 (32 bytes apart), and returns argc.
+            iop_test::Irx image;
+            image.words(0u, {
+                0x3C080001u, 0x35080200u,               // t0 = 0x10200
+                0xAD040000u,                            // [t0] = argc
+                0x240D0000u,                            // i = 0
+                0x01A4702Au, 0x11C00012u, 0x000D7880u,  // 0x10: while (i < argc)        (t7 = i * 4)
+                0x00AF4821u, 0x8D290000u,               //   t1 = argv[i]
+                0x000D5140u, 0x01485021u, 0x254A0020u,  //   t2 = 0x10220 + i * 32
+                0x01E87821u, 0xADE90004u,               //   [0x10204 + i * 4] = t1
+                0x240B001Fu,                            //   at most 32 bytes
+                0x912C0000u, 0x25290001u, 0xA14C0000u,  // 0x3C: *t2 = *t1++
+                0x11800003u, 0x254A0001u,               //   until the terminator
+                0x1560FFFAu, 0x256BFFFFu,
+                0x1000FFEDu, 0x25AD0001u,               // 0x58: ++i
+                0x00047880u, 0x00AF4821u, 0x8D290000u,  // 0x60: t1 = argv[argc]
+                0u, 0xAD09001Cu,                        //   [0x1021C] = t1
+                0x03E00008u, 0x00801021u,               // return argc
+            });
+            const char arguments[] = "sdinit=0\0spucore=2"; // 19 bytes with the last terminator, as the game passes them
+            const auto word = [](const ps2x::iop::IopSubsystem &iop, uint32_t address)
+            {
+                uint32_t value = 0xDEADBEEFu;
+                (void)iop.readMemory(address, &value, sizeof(value));
+                return value;
+            };
+            const auto text = [](const ps2x::iop::IopSubsystem &iop, uint32_t address)
+            {
+                char bytes[33]{};
+                (void)iop.readMemory(address, bytes, 32u);
+                return std::string(bytes);
+            };
+
+            {
+                iop_test::Host host;
+                host.file = image.bytes;
+                ps2x::iop::IopSubsystem subsystem(host);
+                const ps2x::iop::ModuleLoadResult loaded =
+                    subsystem.loadModule("host0:IOP/ARGS.IRX", arguments, static_cast<uint32_t>(sizeof(arguments)));
+                t.IsTrue(loaded.handled && loaded.moduleId > 0, "the synthetic module should load from a file");
+                t.Equals(loaded.startResult, 3, "argc should count the name and the two options");
+                t.Equals(word(subsystem, 0x10200u), 3u, "a0 should be argc, not the byte count of the arguments");
+                t.Equals(text(subsystem, 0x10220u), std::string("host0:IOP/ARGS.IRX"),
+                         "argv[0] should be the path the module was loaded from");
+                t.Equals(text(subsystem, 0x10240u), std::string("sdinit=0"), "argv[1] should be the first option");
+                t.Equals(text(subsystem, 0x10260u), std::string("spucore=2"), "argv[2] should be the second option");
+                t.Equals(word(subsystem, 0x1021Cu), 0u, "argv[argc] should be a null pointer");
+                t.IsTrue(word(subsystem, 0x10208u) > word(subsystem, 0x10204u) &&
+                             word(subsystem, 0x1020Cu) == word(subsystem, 0x10208u) + 9u,
+                         "the argv pointers should follow the strings of the argument block");
+            }
+            {
+                iop_test::Host host;
+                image.install(host);
+                ps2x::iop::IopSubsystem subsystem(host);
+                const ps2x::iop::ModuleLoadResult loaded =
+                    subsystem.loadModuleBuffer(0x1000u, "debug=1", 7u); // no terminator inside the block
+                t.Equals(loaded.startResult, 2, "an argument block without its terminator should still be one string");
+                t.Equals(text(subsystem, 0x10220u), std::string("LBF"),
+                         "a module loaded from a buffer should be started under the name LBF");
+                t.Equals(text(subsystem, 0x10240u), std::string("debug=1"), "the open string should be terminated");
+            }
+            {
+                iop_test::Host host;
+                image.install(host);
+                ps2x::iop::IopSubsystem subsystem(host);
+                const ps2x::iop::ModuleLoadResult loaded = subsystem.loadModuleBuffer(0x1000u);
+                t.Equals(loaded.startResult, 1, "a module started without arguments should still get its name");
+                t.Equals(text(subsystem, 0x10220u), std::string("LBF"), "argv[0] should be the name");
+                t.Equals(word(subsystem, 0x1021Cu), 0u, "argv[1] should be the null pointer then");
+            }
+        });
+
     });
 }
