-        ModuleLoadResult loadImage(std::string path, std::span<const uint8_t> image, const void *arguments, uint32_t argumentSize)
+        // MKSM: the (argc, argv) of a module's start function, written into IOP RAM the way the IOP kernel's modload
+        // builds them: argv[0] is the name the module is started under, then one pointer for each NUL-terminated
+        // string of the argument block, then a null pointer. Returns the block (the argv table, followed by the
+        // strings), 0 when it could not be allocated.
+        uint32_t writeStartArguments(std::string_view name, const void *arguments, uint32_t argumentSize, uint32_t &argc)
+        {
+            std::vector<uint8_t> strings(name.begin(), name.end());
+            strings.push_back(0u);
+            std::vector<uint32_t> offsets{0u};
+            if (arguments && argumentSize)
+            {
+                const auto *bytes = static_cast<const uint8_t *>(arguments);
+                for (uint32_t offset = 0u; offset < argumentSize;)
+                {
+                    offsets.push_back(static_cast<uint32_t>(strings.size()) + offset);
+                    while (offset < argumentSize && bytes[offset] != 0u)
+                        ++offset;
+                    ++offset; // the terminator
+                }
+                strings.insert(strings.end(), bytes, bytes + argumentSize);
+            }
+            strings.push_back(0u); // ends a last string the block left open
+            const uint32_t tableSize = static_cast<uint32_t>(offsets.size() + 1u) * 4u;
+            const uint32_t block = allocate(tableSize + static_cast<uint32_t>(strings.size()), 16u);
+            argc = 0u;
+            if (!block)
+                return 0u;
+            std::vector<uint32_t> table;
+            for (const uint32_t offset : offsets)
+                table.push_back(block + tableSize + offset);
+            table.push_back(0u);
+            writeRam(block, table.data(), tableSize);
+            writeRam(block + tableSize, strings.data(), strings.size());
+            argc = static_cast<uint32_t>(offsets.size());
+            return block;
+        }
+
+        ModuleLoadResult loadImage(std::string path, std::span<const uint8_t> image, const void *arguments, uint32_t argumentSize,
+                                   std::string_view startName = {})
         {
             ModuleLoadResult result{true, -1, -1};
             const IopImageLoadResult loaded = IopModuleLoader::load(image, memory, moduleCursor);
@@ -642,17 +680,13 @@ namespace ps2x::iop::detail
