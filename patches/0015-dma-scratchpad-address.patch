+        // MKSM: Shaolin Monks builds its text packets in the scratchpad and sends them with sceDmaSend(gif, offset |
+        // 0x80000000). Bit 31 of a DMA address selects the scratchpad; the runtime read main memory at the offset (an
+        // empty chain at address 0) and no text was drawn.
+        tc.Run("DMA addresses with the SPR bit read the scratchpad", [](TestCase &t)
+        {
+            PS2Runtime runtime;
+            t.IsTrue(runtime.memory().initialize(), "PS2Memory initialize should succeed");
+            t.IsTrue(runtime.syncCoreSubsystems(), "the GS should be bound to memory");
+            PS2Memory &mem = runtime.memory();
+            uint8_t *rdram = mem.getRDRAM();
+
+            // A GIF chain at scratchpad offset 0x100 that sets FRAME_2's FBP: cnt (GIF tag, A+D pair), then end.
+            const auto writeChain = [&mem](uint64_t fbp)
+            {
+                const uint64_t chain[] = {
+                    2ull | (1ull << 28), 0ull,                  // cnt, 2 quadwords
+                    1ull | (1ull << 15) | (1ull << 60), 0xEull, // PACKED A+D tag, EOP, NLOOP 1
+                    fbp | (10ull << 16), GS_REG_FRAME_2,
+                    7ull << 28, 0ull,                           // end
+                };
+                std::memcpy(mem.getScratchpad() + 0x100u, chain, sizeof(chain));
+            };
+            const auto frame2Fbp = [&runtime] { return runtime.gs().getDebugSnapshot().ctx[1].frame.fbp; };
+
+            R5900Context ctx{};
+            setRegU32(ctx, 4, 0x1000A000u); // GIF channel
+            writeChain(0x50u);
+            setRegU32(ctx, 5, 0x80000100u);
+            ps2_stubs::sceDmaSend(rdram, &ctx, &runtime);
+            t.Equals(frame2Fbp(), 0x50u, "sceDmaSend(offset | 0x80000000) should send the chain in the scratchpad");
+
+            writeChain(0x60u);
+            setRegU32(ctx, 5, 0x70000100u);
+            ps2_stubs::sceDmaSend(rdram, &ctx, &runtime);
+            t.Equals(frame2Fbp(), 0x60u, "sceDmaSend(0x70000000 + offset) should send the chain in the scratchpad");
+
+            writeChain(0x70u);
+            t.IsTrue(mem.writeIORegister(0x1000A030u, 0x80000100u), "the game should be able to set D2_TADR");
+            t.IsTrue(mem.writeIORegister(0x1000A000u, 0x105u), "a D2_CHCR store with STR should start the chain");
+            mem.processPendingTransfers();
+            t.Equals(frame2Fbp(), 0x70u, "a chain started from D2_TADR with the SPR bit should come from the scratchpad");
+
+            // A chain in main memory whose ref tag has the SPR bit (tag bit 63): its data is the scratchpad's.
+            writeChain(0x80u);
+            const uint64_t ref[] = {
