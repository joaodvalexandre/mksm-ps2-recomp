diff --git a/ps2xRuntime/include/runtime/ps2_dma_address.h b/ps2xRuntime/include/runtime/ps2_dma_address.h
new file mode 100644
index 0000000..2999427
--- /dev/null
+++ b/ps2xRuntime/include/runtime/ps2_dma_address.h
@@ -0,0 +1,13 @@
+#pragma once
+
+#include <cstdint>
+
+#include "runtime/ps2_memory.h"
+
+// MKSM: an address as the DMAC reads it (D_MADR, D_TADR, the ADDR of a DMA tag): bit 31 (SPR) selects the scratchpad,
+// at the quadword offset in bits 4-13, and any other address is main memory. (For the EE, 0x80000000 is kseg0; the
+// DMAC has no such mapping.)
+inline uint32_t ps2DmaAddress(uint32_t value)
+{
+    return (value & 0x80000000u) != 0u ? PS2_SCRATCHPAD_BASE + (value & 0x3FF0u) : value;
+}
