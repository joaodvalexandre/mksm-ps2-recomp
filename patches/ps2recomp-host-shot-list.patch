diff --git a/ps2xRuntime/include/runtime/gs/gs_host_shot.h b/ps2xRuntime/include/runtime/gs/gs_host_shot.h
new file mode 100644
index 0000000..00632a5
--- /dev/null
+++ b/ps2xRuntime/include/runtime/gs/gs_host_shot.h
@@ -0,0 +1,27 @@
+// MKSM-Port: the host frames at which the window's back buffer is saved (MKSM_HOST_SHOT), to check presentation
+// without a desktop grab.
+#pragma once
+
+#include <algorithm>
+#include <cstdlib>
+#include <vector>
+
+// MKSM_HOST_SHOT as "<n>[,<n>...]": the host frame numbers to save, sorted and without repeats; empty when unset.
+// Parsing stops at the first item that is not a number.
+inline std::vector<long> gsHostShotFrames(const char *setting)
+{
+    std::vector<long> frames;
+    for (const char *p = setting; p != nullptr && *p != '\0';)
+    {
+        char *end = nullptr;
+        const long frame = std::strtol(p, &end, 10);
+        if (end == p)
+            break;
+        if (frame >= 0)
+            frames.push_back(frame);
+        p = (*end == ',') ? end + 1 : end;
+    }
+    std::sort(frames.begin(), frames.end());
+    frames.erase(std::unique(frames.begin(), frames.end()), frames.end());
+    return frames;
+}
