+    // MKSM: the VU0 macro instructions that set the MAC and status flags: the arithmetic ones (ADD, SUB, MUL, MADD and
+    // MSUB with their broadcast, Q, I and ACC forms, OPMULA and OPMSUB). The two function tables share their layout.
+    bool CodeGenerator::vu0MacroSetsFlags(const Instruction &inst)
+    {
+        if (inst.opcode != OPCODE_COP2 || inst.rs < COP2_CO)
+            return false;
+        uint32_t func = inst.function & 0x3Fu;
+        if (func >= 0x3Cu) // Special2 table
+            func = (((inst.raw >> 6) & 0x1Fu) << 2) | (inst.raw & 0x3u);
+        return func <= 0x0Fu || (func >= 0x18u && func <= 0x1Cu) || func == 0x1Eu ||
+               (func >= 0x20u && func <= 0x2Au) || (func >= 0x2Cu && func <= 0x2Eu);
+    }
+
+    // MKSM: true when nothing can read the flags the VU0 macro instruction at `index` sets: the instructions after it
+    // run in a straight line up to another one that sets them, with no reader in between (CFC2 from the status or the
+    // MAC register, a VU0 micro program). Anything that leaves the straight line keeps the flags. The sticky status
+    // bits of the instructions left out are not accumulated.
+    bool CodeGenerator::vu0FlagsDeadAfter(const std::vector<Instruction> &instructions, size_t index)
+    {
+        for (size_t next = index + 1; next < instructions.size(); ++next)
+        {
+            const Instruction &inst = instructions[next];
+            if (inst.address != instructions[next - 1].address + 4u)
+                return false;
+            if (inst.hasDelaySlot || inst.isBranch || inst.isJump || inst.isCall || inst.isReturn)
+                return false;
+            if (inst.opcode == OPCODE_COP0 ||
+                (inst.opcode == OPCODE_SPECIAL && (inst.function == SPECIAL_SYSCALL || inst.function == SPECIAL_BREAK)))
+                return false;
+            if (inst.opcode != OPCODE_COP2)
+                continue;
+            if (vu0MacroSetsFlags(inst))
+                return true;
+            if (inst.rs == COP2_BC)
+                return false;
+            if (inst.rs == COP2_CFC2 && (inst.rd == VU0_CR_STATUS || inst.rd == VU0_CR_MAC))
+                return false;
+            if (inst.rs >= COP2_CO)
+            {
+                const uint32_t func = inst.function & 0x3Fu;
+                if (func == VU0_S1_VCALLMS || func == VU0_S1_VCALLMSR)
+                    return false;
+            }
+        }
+        return false;
+    }
