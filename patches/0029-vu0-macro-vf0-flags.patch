+// MKSM: the MAC flags of a VU0 macro arithmetic instruction (ADD, SUB, MUL, MADD, MSUB and their forms, OPMULA,
+// OPMSUB). `res` is the instruction's result in all four lanes and `field` its destination mask (x = 8, y = 4, z = 2,
+// w = 1). Zero flags in bits 3..0 and sign flags in bits 7..4, x in the upper bit of each group; the lanes outside the
+// mask are clear. A zero keeps its sign flag. The results are already saturated and flushed (ps2_vfinish), so the
+// underflow and overflow flags (bits 11..8, 15..12) stay clear.
+inline uint32_t ps2_vu0_mac_flags(__m128 res, uint32_t field)
+{
+    // _mm_movemask_ps has x in bit 0; the flags have x in bit 3
+    static constexpr uint8_t kReversed[16] = {0x0, 0x8, 0x4, 0xC, 0x2, 0xA, 0x6, 0xE, 0x1, 0x9, 0x5, 0xD, 0x3, 0xB, 0x7, 0xF};
+    const uint32_t sign = kReversed[_mm_movemask_ps(res) & 15] & field;
+    const uint32_t zero = kReversed[_mm_movemask_ps(_mm_cmpeq_ps(res, _mm_setzero_ps())) & 15] & field;
+    return (sign << 4) | zero;
+}
+
+// MKSM: sets the MAC flags and the status flags of such an instruction: zero and sign in status bits 0 and 1, and their
+// sticky copies in bits 6 and 7. The other status bits (invalid, division by zero and the sticky ones) are kept.
+#define PS2_VU0_FMAC_FLAGS(ctx, res, field)                                                              \
+    do                                                                                                   \
+    {                                                                                                    \
+        const uint32_t ps2_mac_ = ps2_vu0_mac_flags((res), (field));                                     \
+        const uint32_t ps2_cur_ = ((ps2_mac_ & 0x0Fu) ? 1u : 0u) | ((ps2_mac_ & 0xF0u) ? 2u : 0u);      \
+        (ctx)->vu0_mac_flags = ps2_mac_;                                                                 \
+        (ctx)->vu0_status = static_cast<uint16_t>(((ctx)->vu0_status & 0xFF0u) | ps2_cur_ | (ps2_cur_ << 6)); \
+    } while (0)
+
 // PS2 VU (Vector Unit) operations
 #define PS2_VADD(a, b) ps2_vadd((__m128)(a), (__m128)(b))
 #define PS2_VSUB(a, b) ps2_vsub((__m128)(a), (__m128)(b))
