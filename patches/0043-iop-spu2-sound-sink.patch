+                       mipsLui(kA0, semaphoreDescriptor >> 16u), mipsOri(kA0, kA0, semaphoreDescriptor),
+                       mipsJal(createSemaStub), kNop,
+                       stateInto(kT0)[0], stateInto(kT0)[1], mipsSw(kV0, 0x0Cu, kT0),
+                       mipsLui(kA0, threadDescriptor >> 16u), mipsOri(kA0, kA0, threadDescriptor),
+                       mipsJal(createThreadStub), kNop,
+                       stateInto(kT0)[0], stateInto(kT0)[1], mipsSw(kV0, 0x14u, kT0),
+                       mipsAddu(kA0, kV0, kZero), mipsOri(kA1, kZero, 0u),
