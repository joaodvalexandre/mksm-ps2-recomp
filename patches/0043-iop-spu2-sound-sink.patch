+                mipsSh(kT2, 0u, kT1), mipsSh(kT2, 0x200u, kT1),           // a sample, left and right
+                mipsAddiu(kT2, kT2, 1), mipsAddiu(kT3, kT3, -1),
+                mipsBne(kT3, kZero, -5), mipsAddiu(kT1, kT1, 2),
+                mipsAddiu(kT5, kT5, -1),
+                mipsBne(kT5, kZero, -9), mipsAddiu(kT1, kT1, 0x200),      // over the right samples to the next block
+            };
+            code.insert(code.end(), words);
+        };
+        const auto append = [](std::vector<uint32_t> &code, std::initializer_list<uint32_t> words)
+        {
+            code.insert(code.end(), words);
+        };
+
+        std::vector<uint32_t> start;
+        append(start, {mipsAddiu(kSp, kSp, -0x20), mipsSw(kRa, 0x1Cu, kSp),
