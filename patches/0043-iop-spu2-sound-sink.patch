+
+    // The ring's samples reach the output at close to full scale: the sound input of core 0 at full volume, and both
+    // master volumes.
+    void routeSoundInputToOutput(TestHost &host, IopSubsystem &iop)
+    {
+        (void)callLibsd(host, iop, 5u, 0x0800u, 0x00C0u); // MMIX of core 0: the input, left and right
+        (void)callLibsd(host, iop, 5u, 0x0F80u, 0x7FFFu); // BVOLL
+        (void)callLibsd(host, iop, 5u, 0x1080u, 0x7FFFu); // BVOLR
+        for (const uint32_t entry : {0x0980u, 0x0A80u, 0x0981u, 0x0A81u}) // MVOLL and MVOLR of both cores
+            (void)callLibsd(host, iop, 5u, entry, 0x3FFFu);
+    }
+
+    // The counting stream comes out in order: both sides equal, never a step back, and no step larger than the
+    // rounding of the three volumes allows.
+    bool streamIsContinuous(const TestSoundSink &sink)
+    {
+        for (size_t frame = 0; frame < sink.frames(); ++frame)
+        {
+            const int left = sink.samples[frame * 2u], right = sink.samples[frame * 2u + 1u];
+            if (left != right)
+                return false;
+            if (frame != 0u && (left < sink.samples[(frame - 1u) * 2u] || left > sink.samples[(frame - 1u) * 2u] + 2))
+                return false;
+        }
+        return true;
+    }
+
+    // Runs the IOP in small steps until the sink has the frames or the IOP has run 'limit' cycles.
+    void runIopForFrames(IopSubsystem &iop, const TestSoundSink &sink, size_t frames, uint64_t limit)
+    {
+        const uint64_t end = iopCycles(iop) + limit;
+        while (sink.frames() < frames && iopCycles(iop) < end)
+            runIopUntil(iop, iopCycles(iop) + 255u);
+    }
+
+    bool pacedSpu2FollowsSink(TestHost &host, IopSubsystem &iop)
+    {
+        TestSoundSink sink;
+        const SoundSinkScope scope(iop, sink);
+        if (!expect(soundMetric(iop, "paced") == 1u, "the spu2 debug row should say the SPU2 is paced")) return false;
+
+        // 20 ms of the IOP's clock while the output wants nothing: the sound unit stands still
+        runIopUntil(iop, iopCycles(iop) + 20u * 36864u);
+        if (!expect(soundMetric(iop, "frames") == 0u && sink.frames() == 0u,
+                    "a paced SPU2 should make no frame the output did not ask for")) return false;
+
+        // the output is 480 frames short: it gets exactly those, at once
+        sink.wanted = 480u;
+        runIopUntil(iop, iopCycles(iop) + 4096u);
+        if (!expect(sink.frames() == 480u && sink.wanted == 0u && soundMetric(iop, "frames") == 480u,
+                    "a paced SPU2 should make the frames the output is short of")) return false;
+        if (!expect(std::all_of(sink.samples.begin(), sink.samples.end(), [](int16_t sample) { return sample == 0; }),
+                    "an idle sound unit should give silence")) return false;
+
+        // a voice keyed on now is in the very next frames the output asks for
+        const uint8_t block[16] = {0x00, 0x07, 0x11, 0x11, 0x11, 0x11, 0x11, 0x11, 0x11, 0x11, 0x11, 0x11, 0x11, 0x11, 0x11, 0x11};
+        if (!expect(iop.writeMemory(kSoundSource, block, sizeof(block)), "could not fill IOP RAM")) return false;
+        (void)callLibsd(host, iop, 17u, 0u, 8u, kSoundSource, 0x00020000u, sizeof(block)); // upload
+        (void)callLibsd(host, iop, 9u, 0x2000u, 0x00020000u); // SSA of voice 0 on core 0
+        (void)callLibsd(host, iop, 5u, 0x0000u, 0x3FFFu);     // VOLL
+        (void)callLibsd(host, iop, 5u, 0x0100u, 0x3FFFu);     // VOLR
+        (void)callLibsd(host, iop, 5u, 0x0200u, 0x1000u);     // PITCH: 48 kHz
+        (void)callLibsd(host, iop, 5u, 0x0300u, 0x000Fu);     // ADSR1: fastest attack
+        (void)callLibsd(host, iop, 7u, 0x1800u, 1u);          // VMIXL
+        (void)callLibsd(host, iop, 7u, 0x1A00u, 1u);          // VMIXR
+        for (const uint32_t entry : {0x0980u, 0x0A80u, 0x0981u, 0x0A81u})
+            (void)callLibsd(host, iop, 5u, entry, 0x3FFFu);   // the master volumes
+        sink.samples.clear();
+        (void)callLibsd(host, iop, 7u, 0x1500u, 1u);          // KON
+        sink.wanted = 256u;
+        runIopUntil(iop, iopCycles(iop) + 4096u);
+        if (!expect(sink.frames() == 256u, "the output should get the frames it asked for after the key-on")) return false;
+        return expect(sink.samples[2u * 255u] > 3000 && sink.samples[2u * 255u + 1u] > 3000,
+                      "the keyed-on voice should be heard in the frames the output asked for");
+    }
+
+    bool pacedSpu2WaitsForRefill(TestHost &host, IopSubsystem &iop)
+    {
+        TestSoundSink sink;
+        const SoundSinkScope scope(iop, sink);
+        routeSoundInputToOutput(host, iop);
+        writeRefillStreamDriverIrx(host, 0x100u, false);
+        const ModuleLoadResult driver = iop.loadModuleBuffer(0x100u);
+        if (!expect(driver.handled && driver.startResult == 0 && iopWord(iop, kSoundState + 0x1Cu) == 0x800u,
+                    "the refilling stream driver did not start")) return false;
+        if (!expect(iopWord(iop, kSoundState) == 1u,
+                    "the first half should call the handler when the transfer starts")) return false;
+
+        // The output is short of twelve times what the ring holds. Each half is refilled by a thread after its
+        // interrupt, and the SPU2 must not read on before that thread has run: the stream comes out in order.
+        constexpr size_t frames = 12000u;
+        sink.wanted = frames;
+        runIopForFrames(iop, sink, frames, 4'000'000u);
+        if (!expect(sink.frames() == frames, "the output should get all the frames it asked for")) return false;
+        if (!expect(streamIsContinuous(sink), "no block should be played twice or skipped")) return false;
+        if (!expect(sink.samples[2u * (frames - 1u)] > 11900 && sink.samples[2u * (frames - 1u)] < 12000,
+                    "the last frame should be the stream's twelve-thousandth sample")) return false;
+        if (!expect(soundMetric(iop, "repeated_blocks") == 0u, "no block should be fetched twice unchanged")) return false;
+        const uint32_t interrupts = iopWord(iop, kSoundState), refills = iopWord(iop, kSoundState + 0x18u);
+        if (!expect(interrupts >= frames / 512u && (refills == interrupts || refills + 1u == interrupts),
+                    "every half should have been refilled once, after its interrupt")) return false;
+        return expect(soundMetric(iop, "holds") == interrupts && soundMetric(iop, "hold_timeouts") == 0u,
+                      "every transfer interrupt should hold the SPU2 until the IOP is idle again");
+    }
+
+    bool pacedHoldIsBounded(TestHost &host, IopSubsystem &iop)
+    {
+        TestSoundSink sink;
+        const SoundSinkScope scope(iop, sink);
+        routeSoundInputToOutput(host, iop);
+        writeRefillStreamDriverIrx(host, 0x100u, true); // with a thread that never waits: the IOP is never idle
+        const ModuleLoadResult driver = iop.loadModuleBuffer(0x100u);
+        if (!expect(driver.handled && driver.startResult == 0, "the refilling stream driver did not start")) return false;
+
+        // the hold after the first interrupt lasts 3 ms of IOP time (110,592 cycles), not for ever
+        sink.wanted = 2048u;
+        runIopUntil(iop, iopCycles(iop) + 100'000u);
+        if (!expect(sink.frames() == 0u, "the SPU2 should hold while the driver may still be refilling")) return false;
+        runIopForFrames(iop, sink, 2048u, 2'000'000u);
+        if (!expect(sink.frames() == 2048u, "a busy IOP should not stop the sound for ever")) return false;
+        if (!expect(soundMetric(iop, "hold_timeouts") >= 3u, "the holds should have ended on their bound")) return false;
+        return expect(streamIsContinuous(sink) && soundMetric(iop, "repeated_blocks") == 0u,
+                      "the refill thread outranks the busy one: the stream should still come out in order");
+    }
