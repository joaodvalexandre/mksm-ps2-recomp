@@ -0,0 +1,25 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+
+namespace ps2x::iop
+{
+    // MKSM: where the SPU2's mixed output goes, and the clock the SPU2 runs on. With a sink set
+    // (IopSubsystem::setSoundSink) the SPU2 makes exactly the frames the sink asks for: the sink is the audio
+    // output's buffer, so the sound unit advances with the audio device (48,000 frames for each second the device
+    // plays), whatever the emulated IOP's own clock does. The driver's transfer interrupts are raised at the frame
+    // they belong to, and after one the SPU2 waits until the IOP has run the driver's refill. Without a sink the
+    // SPU2 is clocked by IOP cycles (one frame every 768) and keeps its frames to itself.
+    // Both functions are called on the thread that runs the IOP, at every service point of the emulator.
+    class IopSoundSink
+    {
+    public:
+        virtual ~IopSoundSink() = default;
+
+        // The stereo frames the output is short of right now; 0 while it has what it needs. Called very often.
+        virtual size_t framesWanted() noexcept = 0;
+        // Frames in playback order: interleaved signed 16-bit stereo at 48 kHz.
+        virtual void writeFrames(const int16_t *stereo, size_t frames) noexcept = 0;
+    };
+}
