+            t.Equals(getRegS32(env.ctx, 2), 9, "ChangeThreadPriority returns the previous priority (9)");
+            setRegU32(env.ctx, 5, 200u);
+            ChangeThreadPriority(env.rdram.data(), &env.ctx, &env.runtime);
+            t.Equals(getRegS32(env.ctx, 2), kIllegalPriority, "an illegal priority still returns the error");
+        });
