+        // MKSM: the EE kernel's priorities are 0 to 127 and the main thread starts at 0, so a game that creates its
+        // worker threads with the priority ReferThreadStatus reports for the main thread passes 0. Rejecting it left
+        // such a game without its workers.
+        tc.Run("CreateThread and ChangeThreadPriority accept priority 0", [](TestCase &t)
+        {
+            TestEnv env;
+            EeThreadCreateAbi threadParam{};
+            threadParam.func = K_SCHED_HIGH;
+            threadParam.stack = 0x00018000u;
+            threadParam.stack_size = 0x1000;
+            threadParam.gp_reg = 0x00123400u;
+            threadParam.initial_priority = 0;
+            std::memcpy(env.rdram.data() + K_PARAM_ADDR, &threadParam, sizeof(threadParam));
+
+            setRegU32(env.ctx, 4, K_PARAM_ADDR);
+            CreateThread(env.rdram.data(), &env.ctx, &env.runtime);
+            const int threadId = getRegS32(env.ctx, 2);
+            const GuestThread *thread = env.runtime.eeScheduler().thread(threadId);
+            t.IsTrue(threadId >= 2 && thread != nullptr, "priority 0 is a valid initial priority");
+            if (thread != nullptr)
+            {
+                t.Equals(thread->currentPriority, 0, "the thread keeps priority 0");
+            }
+
+            int oldPriority = -1;
+            t.Equals(env.runtime.eeScheduler().changePriority(threadId, 5, false, oldPriority), KE_OK,
+                     "a priority change away from 0 succeeds");
+            t.Equals(oldPriority, 0, "the previous priority was 0");
+            t.Equals(env.runtime.eeScheduler().changePriority(threadId, 0, false, oldPriority), KE_OK,
+                     "a priority change to 0 succeeds");
+            t.Equals(oldPriority, 5, "the previous priority was 5");
+            constexpr int kIllegalPriority = -403; // KE_ILLEGAL_PRIORITY
+            t.Equals(env.runtime.eeScheduler().changePriority(threadId, -1, false, oldPriority), kIllegalPriority,
+                     "a negative priority is still illegal");
+            t.Equals(env.runtime.eeScheduler().changePriority(threadId, 128, false, oldPriority), kIllegalPriority,
+                     "a priority of 128 is still illegal");
+
+            // The syscall returns the previous priority (the EE kernel's contract), not KE_OK: a critical section
+            // helper of the game raises the current thread with ChangeThreadPriority(id, 1) and restores whatever that
