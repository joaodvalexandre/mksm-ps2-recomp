     void sceGsSetDefLoadImage(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
     {
+        // MKSM-Port: libgraph's sceGsLoadImage is the GIF packet itself (0x60 bytes): a PACKED A+D tag (NLOOP 4) with
+        // BITBLTBUF (DBP as given, in 64-word units), TRXPOS, TRXREG and TRXDIR, then the IMAGE tag (EOP) whose NLOOP is
+        // the image size in quadwords; it returns 6, the header's length. A private record whose DBP sceGsExecLoadImage
+        // scaled by 8 put every texture of Mortal Kombat: Shaolin Monks outside GS memory (blank textures, black screen).
+        const uint32_t lpAddr = getRegU32(ctx, 4);
+        const GsSetDefImageArgs args = decodeGsSetDefImageArgs(rdram, ctx);
+        uint8_t *lp = getMemPtr(rdram, lpAddr);
+        if (!lp)
+        {
+            setReturnS32(ctx, 0);
+            return;
+        }
+        // the arguments are shorts; the quadword count by format is libgraph's table
+        const int64_t dbp = static_cast<int16_t>(args.vramAddr), dbw = static_cast<int16_t>(args.vramWidth);
+        const int64_t dpsm = static_cast<int16_t>(args.psm), x = static_cast<int16_t>(args.x);
+        const int64_t y = static_cast<int16_t>(args.y), w = static_cast<int16_t>(args.width), h = static_cast<int16_t>(args.height);
+        int64_t qwc = 0;
+        switch (dpsm)
+        {
+        case GS_PSM_CT32: case GS_PSM_Z32: qwc = (w * h) >> 2; break;
+        case GS_PSM_CT24: case GS_PSM_Z24: qwc = (w * h * 3) >> 4; break;
+        case GS_PSM_CT16: case GS_PSM_CT16S: case GS_PSM_Z16: case GS_PSM_Z16S: qwc = (w * h) >> 3; break;
+        case GS_PSM_T8: case GS_PSM_T8H: qwc = (w * h) >> 4; break;
+        case GS_PSM_T4: case GS_PSM_T4HL: case GS_PSM_T4HH: qwc = (w * h) >> 5; break;
+        default: break;
+        }
+        if (qwc > 0x7FFF)
+        {
+            setReturnS32(ctx, 0);
+            return;
+        }
+        const auto bits = [](int64_t value) { return static_cast<uint64_t>(value); };
+        uint64_t q[12] = {};
+        q[0] = 4ull | (1ull << 60);                     // NLOOP 4, PACKED, NREG 1
+        q[1] = 0xEull;                                  // A+D
+        q[2] = (bits(dbp) << 32) | (bits(dbw) << 48) | (bits(dpsm) << 56);
+        q[3] = GS_REG_BITBLTBUF;
+        q[4] = (bits(x) << 32) | (bits(y) << 48);
+        q[5] = GS_REG_TRXPOS;
+        q[6] = bits(w) | (bits(h) << 32);
+        q[7] = GS_REG_TRXREG;
+        q[8] = 0ull;                                    // host -> local
+        q[9] = GS_REG_TRXDIR;
+        q[10] = static_cast<uint64_t>(qwc & 0x7FFF) | (1ull << 15) | (2ull << 58); // NLOOP, EOP, IMAGE
+        q[11] = 0ull;
+        std::memcpy(lp, q, sizeof(q));
+        setReturnS32(ctx, 6);
+    }
